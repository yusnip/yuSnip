<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ScreenCaptureTool.Controls.AnnotationColorControl">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="CustomButton" Classes="swatch" ToolTip.Tip="自定义颜色" Click="OnCustomClick">
            <Grid Width="20" Height="20">
                <Border CornerRadius="6">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#FFFF4D4F" Offset="0" />
                            <GradientStop Color="#FFFFC53D" Offset="0.22" />
                            <GradientStop Color="#FF52C41A" Offset="0.42" />
                            <GradientStop Color="#FF13C2C2" Offset="0.62" />
                            <GradientStop Color="#FF2F54EB" Offset="0.8" />
                            <GradientStop Color="#FFEB2F96" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="ColorPreview" Width="15" Height="15" CornerRadius="5"
                        Background="#FF3388FF" BorderBrush="#FFFFFFFF" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Button>
        <ItemsControl x:Name="Swatches">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </StackPanel>
</UserControl>
