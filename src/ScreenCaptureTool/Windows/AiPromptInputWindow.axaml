<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:round="using:ScreenCaptureTool.Controls"
        xmlns:ai="clr-namespace:ScreenCaptureTool.Core.Ai;assembly=ScreenCaptureTool.Core"
        x:Class="ScreenCaptureTool.Windows.AiPromptInputWindow"
        Icon="/Assets/Black.ico"
        Title="AI 识图提问"
        Width="528"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei UI', Roboto, sans-serif"
        FontSize="14">


    <Window.Styles>
        <StyleInclude Source="/Themes/Workspace.axaml" />
        <StyleInclude Source="/Themes/WorkspaceMenus.axaml" />
        <StyleInclude Source="/Themes/WorkspaceAi.axaml" />
        <StyleInclude Source="/Themes/WorkspaceToolTips.axaml" />
        <!-- 极简无框多行输入框 -->
        <Style Selector="TextBox.flatPromptInput">
            <Setter Property="FontFamily" Value="-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei UI', Roboto, sans-serif" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SctOcrSelectionBrush}" />
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource SctTextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource SctAccentBrush}" />
        </Style>
        <Style Selector="TextBox.flatPromptInput /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.flatPromptInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.flatPromptInput:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- 极简现代纸飞机发送按钮（圆形居中） -->
        <Style Selector="Button.sendAction">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource SctAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.sendAction /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SctAccentBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.sendAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SctAccentHoverBrush}" />
        </Style>
        <Style Selector="Button.sendAction:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SctAccentPressedBrush}" />
        </Style>

        <!-- 胶囊式模型下拉菜单（限高但给足可视行数，支持滚轮滚动）。
             原先 160px 只放得下 4~5 行，而首行是服务商分组标题，默认模型常排在第 5 项之后，
             展开后正好落在可视区之外——用户观感就是"模型没显示全、被缩进去了"。 -->
        <Style Selector="ComboBox.modelPillSelect">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource SctCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,0,6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ComboBox.modelPillSelect:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource SctCardFillHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctBorderBrush}" />
        </Style>
        <Style Selector="ComboBox.modelPillSelect:focus /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource SctCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctAccentBrush}" />
        </Style>
    </Window.Styles>

    <!-- 外层卡片：双层细腻柔和漫射阴影 + 精确计算的 24,18,24,34 外边距（彻底杜绝阴影触碰窗体边缘被硬性截断） -->
    <round:ContinuousBorder x:Name="RootCardBorder"
            Margin="24,18,24,34"
            CornerRadius="{DynamicResource SctRadiusCard}"
            Background="{DynamicResource SctCardBrush}"
            BorderBrush="{DynamicResource SctBorderBrush}"
            BorderThickness="1"
            BoxShadow="{DynamicResource SctAiPromptShadow}"
            PointerPressed="OnCardPointerPressed">

        <Panel>
            <!-- ════ 1. 单次扫光动效层 ════ -->
            <Border x:Name="ShimmerSweepOverlay"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    CornerRadius="0"
                    Opacity="0"
                    ZIndex="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0.0" Color="#00FFFFFF" />
                        <GradientStop Offset="0.4" Color="#00FFFFFF" />
                        <GradientStop Offset="0.5" Color="#22FFFFFF" />
                        <GradientStop Offset="0.6" Color="#44FFFFFF" />
                        <GradientStop Offset="0.7" Color="#22FFFFFF" />
                        <GradientStop Offset="0.8" Color="#00FFFFFF" />
                        <GradientStop Offset="1.0" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <TranslateTransform X="-530" Y="0" />
                </Border.RenderTransform>
            </Border>

            <!-- ════ 2. 现代分层结构：沉浸多行输入区 + 1px 细线 + 一体化微底栏 ════ -->
            <Grid RowDefinitions="Auto,Auto,Auto">
                <!-- 2.1 主体多行输入区（将快捷提示自然融合到 Watermark 中） -->
                <TextBox x:Name="TxtPromptInput"
                         Grid.Row="0"
                         Classes="flatPromptInput"
                         FocusAdorner="{x:Null}"
                         AcceptsReturn="False"
                         TextWrapping="Wrap"
                         MinHeight="54"
                         MaxHeight="150"
                         Margin="16,14,16,12"
                         VerticalContentAlignment="Top"
                         Watermark="输入提示词或提问…（@ 唤起预设，Enter 发送，Esc 退出）" />

                <!-- 2.2 优雅 1px 分隔线 -->
                <Border Grid.Row="1"
                        Height="1"
                        Background="{DynamicResource SctSoftBorderBrush}" />

                <!-- 2.3 底部一体化操作底栏：左侧胶囊模型选择，右侧纸飞机发送按钮 -->
                <Border Grid.Row="2"
                        Background="{DynamicResource SctCardFillBrush}"
                        CornerRadius="0"
                        Padding="12,8,12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <!-- 左侧：模型选择器（MaxDropDownHeight 320，支持向下展开与滚动） -->
                        <ComboBox x:Name="CmbModelSelect"
                                  Grid.Column="0"
                                  Classes="modelPillSelect"
                                  MinWidth="120"
                                  MaxDropDownHeight="320"
                                  VerticalAlignment="Center"
                                  SelectionChanged="OnModelSelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="ai:AiModelDropDownItem">
                                    <Panel>
                                        <!-- Header 类型 -->
                                        <Border IsVisible="{Binding IsHeader}"
                                                Padding="4,4,4,2">
                                            <TextBlock Text="{Binding DisplayText}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource SctCardTitleBrush}" />
                                        </Border>
                                        <!-- Separator 类型 -->
                                        <Border IsVisible="{Binding IsSeparator}"
                                                Height="1"
                                                Margin="2,2"
                                                Background="{DynamicResource SctSoftBorderBrush}" />
                                        <!-- Model 类型 -->
                                        <StackPanel Orientation="Horizontal" IsVisible="{Binding IsModel}" Spacing="6" Margin="4,1">
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SctAccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DisplayText}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Panel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- 中间：空白拖拽手柄区（透明透传拖拽） -->
                        <Border Grid.Column="1" Background="Transparent" />

                        <!-- 右侧：现代化纯几何纸飞机发送按钮（光学质心微调绝对居中） -->
                        <Button x:Name="BtnSendPrompt"
                                Grid.Column="2"
                                Classes="sendAction workspaceCircle"
                                VerticalAlignment="Center"
                                ToolTip.Tip="发送 (Enter)"
                                Click="OnSendPromptClick">
                            <!-- 纸飞机矢量图标：通过光学平移微调 (+1.2px, -0.4px) 使视觉重心在圆形按钮中严格居中 -->
                            <Path Width="13" Height="13"
                                  Fill="{DynamicResource SctTitleBarCloseTextBrush}"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransform="translate(1.2px, -0.4px)"
                                  Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Panel>
    </round:ContinuousBorder>
</Window>
