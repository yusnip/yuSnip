<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:core="clr-namespace:ScreenCaptureTool.Core;assembly=ScreenCaptureTool.Core"
        xmlns:win="clr-namespace:ScreenCaptureTool.Windows"
        xmlns:services="using:ScreenCaptureTool.Services"
        xmlns:controls="using:ScreenCaptureTool.Controls"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
        x:Class="ScreenCaptureTool.Windows.SettingsWindow"
        Icon="/Assets/Black.ico"
        Title="设置 - yuSnip"
        Width="1080" Height="760"
        MinWidth="940" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        Background="{DynamicResource SctTitleBarBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">

    <!-- Workspace 颜色由 Themes/Colors.axaml 提供，控件主题由 Themes/Workspace.axaml 映射，
         本窗口不再持有局部 ThemeDictionaries 覆盖，回归三层样式架构。 -->

    <Window.Styles>
        <StyleInclude Source="avares://yuSnip/Themes/Workspace.axaml" />
        <StyleInclude Source="/Themes/WorkspaceMenus.axaml" />

        <!-- 卡片标题与分组标题：字号统一为 13.5，仅重一个字重（SemiBold） -->
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SctCardTitleBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style Selector="TextBlock.subSectionTitle">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SctSubTitleBrush}" />
            <Setter Property="Margin" Value="2,10,0,6" />
        </Style>

        <!-- 快捷键与动作行样式 -->
        <Style Selector="Border.shortcutRow">
            <Setter Property="Background" Value="{DynamicResource SctRowBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="Border.shortcutRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SctRowHoverBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctBorderBrush}" />
        </Style>

        <!-- 键帽按钮基础样式（keycap / pointerover / recording）复用 Controls.axaml 全局样式 -->
        <!-- 冲突态：依赖本窗口局部 danger 画笔，保留在此 -->
        <Style Selector="Button.keycap.conflict">
            <Setter Property="Background" Value="{DynamicResource SctDangerBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctDangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SctDangerBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.keycap.conflict /template/ ContentPresenter#PART_ContentPresenter, Button.keycap.conflict /template/ ContentPresenter#PART_ContinuousPresenter">
            <Setter Property="Background" Value="{DynamicResource SctDangerBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctDangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SctDangerBrush}" />
        </Style>

        <!-- 危险操作按钮（Button.danger / Button.danger.ghost）2026-09-29 上收到 Themes/Controls.axaml：
             画质预设编辑窗也要用同一族，按设计规范 §2 只留一份定义 -->

        <!-- 指南代码盒 -->
        <Style Selector="Border.guideBox">
            <Setter Property="Background" Value="{DynamicResource SctTitleBarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusCard}" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        
        <!-- 文本链接按钮（Button.link）已上提到全局 Themes/Controls.axaml -->

        <!-- 外链获取密钥胶囊按钮：徽标淡紫底 + 品牌紫字，比右侧主按钮矮一档保证主次，配色全部走 SctBadge* Token -->
        <Style Selector="Button.apiKeyEntry">
            <Setter Property="Background" Value="{DynamicResource SctBadgeBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SctBadgeTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MaxHeight" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.apiKeyEntry /template/ ContentPresenter#PART_ContentPresenter, Button.apiKeyEntry /template/ ContentPresenter#PART_ContinuousPresenter">
            <Setter Property="Background" Value="{DynamicResource SctBadgeBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SctBadgeTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.apiKeyEntry:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.apiKeyEntry:pointerover /template/ ContentPresenter#PART_ContinuousPresenter">
            <Setter Property="Background" Value="{DynamicResource SctBadgeBgHoverBrush}" />
        </Style>
        <Style Selector="Path.apiKeyEntryIcon">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{DynamicResource SctBadgeTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 验证结果内联状态：贴在验证按钮左侧，成功=品牌紫、失败=危险红（基础排布在前，状态配色在后） -->
        <Style Selector="StackPanel.translateStatus > TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.translateStatus > Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.translateStatus.ok > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SctBadgeTextBrush}" />
        </Style>
        <Style Selector="StackPanel.translateStatus.ok > Path">
            <Setter Property="Fill" Value="{DynamicResource SctBadgeTextBrush}" />
        </Style>
        <Style Selector="StackPanel.translateStatus.err > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SctDangerBrush}" />
        </Style>
        <Style Selector="StackPanel.translateStatus.err > Path">
            <Setter Property="Fill" Value="{DynamicResource SctDangerBrush}" />
        </Style>
        
        <!-- 品牌主色强调按钮 / 表单标签 / 表单提示 / 分段选择器：统一复用 Controls.axaml 全局样式，勿在此重复定义 -->

        <!-- ════════ AI 服务商列表项样式（C# 动态构建时按 Classes 挂载，主题色走 DynamicResource 自动跟随） ════════ -->
        <!-- 协议徽标：浅色=淡靛紫底+靛紫字，深色=半透明靛紫底+亮紫字（Colors.axaml 全局 SctBadge* 资源） -->
        <Style Selector="Border.providerBadge">
            <Setter Property="Background" Value="{DynamicResource SctBadgeBgBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusSmall}" />
            <Setter Property="Padding" Value="6,1.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.providerBadgeText">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource SctBadgeTextBrush}" />
        </Style>
        <!-- 摘要行单色 SVG 图标（跟随主题次级文字色，禁止彩色/emoji） -->
        <Style Selector="Path.providerDetailIcon">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{DynamicResource SctTextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.providerDetailText">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.fieldRow">
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <!-- fieldRow 的同一档行高也要给"用 Grid 铺的行"：本窗大量行是 <c>Grid Classes="fieldRow">（如「主题」「翻译语言」那些），
             而这一度只定义了 Border.fieldRow ⇒ 类空挂、MinHeight 拿不到，行距全靠 Spacing 凑（设计稿第 15 份 P3）。
             值与上面逐字相同，不开第二套尺寸。 -->
        <Style Selector="Grid.fieldRow">
            <Setter Property="MinHeight" Value="44" />
        </Style>

        <!-- 画质预设的一档一行（2026-09-29 第五版＝行只读＋双击开编辑窗）：逐值照 hotkeyRow 那一族，
             只把内距收到 10,7 让六档排得下。
             🔴 底色/描边一律走样式类，代码里只增删 Classes——原实现用 FindBrush 在 C# 里取画刷，
             违反设计规范 §2「C# 无画刷原则」（设计稿第 15 份 P1）。
             ⚠ 原先还有第三条 `.selected`（就地展开态的高亮描边），随"原地展开"一起退役：
             行不再有选中态，只有悬浮反馈与双击手势。 -->
        <Style Selector="Border.recPresetItem">
            <Setter Property="Background" Value="{DynamicResource SctRowBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Border.recPresetItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SctRowHoverBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctBorderBrush}" />
        </Style>
        <!-- 画质预设行上的"数字块"（2026-09-29 卡片流 S3；同日实报收口）：数值 13.5 SemiBold ＋ 字段名 11 号三级灰。
             ⚠ 数值原先是 16 号 Medium，实测与同页 13.5 的档名/卡头差一档、显得突兀，用户拍板「加粗就够了，不要那么大字号」
             ⇒ 字号回到控件主力档 13.5（§4.2），层级改由 §4.3 的 SemiBold（标题类字重）拉开，不再靠字号。
             ⚠ 数值不走框——行是"读数"，改值在双击弹出的编辑窗里，那里才是输入框。
             单位并入 11 号那行文字（"FPS""Mbps""MB/分钟"），所以不再有 inputUnit 那类私有类
             （它的历史：单位先挂框外、再钉框内，两次都被实测否掉，判据留在 docs/设计规范.md §6.5）。 -->
        <Style Selector="TextBlock.recStatVal">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.recStatCap">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextTertiaryBrush}" />
        </Style>
        <!-- 展开行的小标签（12 号三级灰，"帧率 FPS" 这种带单位的整体写在一个 TextBlock 里）：
             直接挂全局 fieldHint 即可，不开第二套。 -->
        <!-- TextBox / ComboBox 已收敛至 Controls.axaml 全局基准（32px 高、8px 圆角、SctInputBgBrush 底色），勿在此重复定义 -->
        <!-- softDivider 已集中到 Controls.axaml，设置与版本窗口共用。 -->

        <!-- 快捷键/动作行样式（与 C# 中 hotkeyRow 类对应） -->
        <Style Selector="Border.hotkeyRow">
            <Setter Property="Background" Value="{DynamicResource SctRowBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style Selector="Border.hotkeyRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SctRowHoverBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctBorderBrush}" />
        </Style>

        <!-- 快捷键双列表格矩阵（方案C）：左右等宽列铺满卡片、发丝线分隔、组头为浅底通栏标签 -->
        <Style Selector="Border.hotkeyMatrix">
            <Setter Property="Background" Value="{DynamicResource SctCardFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusCard}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <!-- 右列：左侧发丝线与左列分隔（两列等宽，分隔线天然居中） -->
        <Style Selector="Border.hotkeyMatrixCol">
            <Setter Property="BorderBrush" Value="{DynamicResource SctSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>
        <!-- 组头：浅底通栏标签 -->
        <Style Selector="Border.hotkeyMatrixHead">
            <Setter Property="Background" Value="{DynamicResource SctRowBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,5" />
        </Style>
        <Style Selector="TextBlock.hotkeyMatrixHeadText">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextSecondaryBrush}" />
        </Style>
        <!-- 矩阵行：无独立卡片框，底部发丝线分隔（末行加 last 类去线），悬浮整行浅底高亮 -->
        <Style Selector="Border.hotkeyMatrixRow">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.hotkeyMatrixRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SctRowHoverBgBrush}" />
        </Style>
        <Style Selector="Border.hotkeyMatrixRow.last">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- 卡片描述文字（与全局 fieldHint 同档：12 + 三级灰） -->
        <Style Selector="TextBlock.cardDesc">
            <Setter Property="Foreground" Value="{DynamicResource SctTextTertiaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- 服务商连接状态点：默认三级灰（未连接），.on 绿。画刷一律挂样式类，代码里只翻类名——
             §2「C# 无画刷原则」；参照图那版把圆点写死成 #8A8A8A，深色档下会糊成一块。 -->
        <Style Selector="Ellipse.statusDot">
            <Setter Property="Fill" Value="{DynamicResource SctTextTertiaryBrush}" />
        </Style>
        <Style Selector="Ellipse.statusDot.on">
            <Setter Property="Fill" Value="{DynamicResource SctOkBrush}" />
        </Style>

        <!-- 「云端版本」这类"点进另一扇窗"的入口：紫描边＋紫字＋尾部箭头，悬浮铺一档 12% 品牌紫底。
             它必须明显区别于同排的灰色次级按钮（否则看不出可点），又不能抢那枚实底主按钮——
             一行仍只有一枚 primary（设计规范 §6.2）。全部取现成 Token，不新增色值。 -->
        <Style Selector="Button.entry">
            <Setter Property="BorderBrush" Value="{DynamicResource SctAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SctAccentBrush}" />
        </Style>
        <Style Selector="Button.entry /template/ ContentPresenter#PART_ContentPresenter, Button.entry /template/ ContentPresenter#PART_ContinuousPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctAccentBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SctAccentBrush}" />
        </Style>
        <Style Selector="Button.entry:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.entry:pointerover /template/ ContentPresenter#PART_ContinuousPresenter">
            <Setter Property="Background" Value="{DynamicResource SctBadgeBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctAccentHoverBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SctAccentHoverBrush}" />
        </Style>
        <Style Selector="Button.entry:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.entry:pressed /template/ ContentPresenter#PART_ContinuousPresenter">
            <Setter Property="Background" Value="{DynamicResource SctBadgeBgHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctAccentPressedBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SctAccentPressedBrush}" />
        </Style>

        <!-- ════════ 录屏分区（稿 4）/ 依赖运行页：状态胶囊 / 下载进度条 / 只读键帽 ════════ -->
        <!-- 状态胶囊：默认中性，.ok 绿（已就绪）/ .bad 红（未安装）/ .busy 品牌紫实底白字（下载中），配色走 Sct* Token -->
        <Style Selector="Border.statusPill">
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SctRowBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.statusPill TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextSecondaryBrush}" />
        </Style>
        <Style Selector="Border.statusPill.ok">
            <Setter Property="Background" Value="{DynamicResource SctOkBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctOkBorderBrush}" />
        </Style>
        <Style Selector="Border.statusPill.ok TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SctOkBrush}" />
        </Style>
        <Style Selector="Border.statusPill.bad">
            <Setter Property="Background" Value="{DynamicResource SctDangerBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctDangerBrush}" />
        </Style>
        <Style Selector="Border.statusPill.bad TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SctDangerBrush}" />
        </Style>
        <Style Selector="Border.statusPill.busy">
            <Setter Property="Background" Value="{DynamicResource SctAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctAccentBrush}" />
        </Style>
        <Style Selector="Border.statusPill.busy TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SctStatusTextBrush}" />
        </Style>
        <!-- 下载进度条：轨道通宽 ×6 圆角，填充宽度由代码按实测轨宽×百分比给出（依赖运行页三行共用） -->
        <Style Selector="Border.dlTrack">
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusSmall}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="{DynamicResource SctRowBgBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.dlFill">
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusSmall}" />
            <Setter Property="Background" Value="{DynamicResource SctAccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <!-- 功能分组小标题 -->
        <Style Selector="TextBlock.groupLabel">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SctSubTitleBrush}" />
            <Setter Property="Margin" Value="2,10,0,6" />
        </Style>

        <!-- 提示行（解释文字档） -->
        <Style Selector="TextBlock.hintRow">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="4,8,0,0" />
        </Style>

        <!-- 工具池候选：图标 + 名称的紧凑 chip（28px，无按钮）。已占用的整枚降透明、不可拖——灰态自己说话，不再写"灰色表示…" -->
        <Style Selector="Border.toolbarItem">
            <Setter Property="Background" Value="{DynamicResource SctInputBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="SizeAll" />
        </Style>
        <Style Selector="Border.toolbarItem:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SctAccentBrush}" />
        </Style>
        <Style Selector="Border.toolbarItem.dragging">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Border.toolbarItem.inactive">
            <Setter Property="Opacity" Value="0.38" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style Selector="Path.toolbarIcon">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Path.tbFill">
            <Setter Property="Fill" Value="{DynamicResource SctIconBrush}" />
        </Style>
        <Style Selector="Path.tbStroke">
            <Setter Property="Stroke" Value="{DynamicResource SctIconBrush}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="Border.tbDividerV">
            <Setter Property="Background" Value="{DynamicResource SctSeparatorBrush}" />
        </Style>
        <Style Selector="Button.simIcon">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
            <Setter Property="Foreground" Value="{DynamicResource SctIconBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.toolbarHit">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="SizeAll" />
        </Style>
        <Style Selector="Button.dragging">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="StackPanel.toolbarPreviewGroup.dragging">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Border.toolbarHit.dragging">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <!-- ============ 工具栏「组」区（方案甲 · 并排抽屉格）============ -->
        <!-- 一张卡＝一个组。上栏与未上栏的区分：未上栏整卡降一档 + 虚线描边（Avalonia 的 Border 画不出虚线，
             虚线只能叠 Rectangle）；上栏则是正常描边的实底卡，不加任何额外标记线 -->
        <Style Selector="Border.tbGroupCard">
            <Setter Property="Background" Value="{DynamicResource SctInputBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusCard}" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="Border.tbGroupCard.dropOver">
            <Setter Property="BorderBrush" Value="{DynamicResource SctAccentBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Border.tbGroupCard.off">
            <Setter Property="Opacity" Value="0.62" />
        </Style>
        <!-- 紫色虚线框只服务"待新建 / 可放置"那一类格子：新建组瓦片与空状态引导卡。
             2026-09-20 按用户要求撤掉了组卡上的那一层——它贴着卡片 1px 实线的内沿，看着就是"多一条框"（见设计规范 §9 铁律 15） -->
        <Style Selector="Rectangle.tbGroupDash">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Stroke" Value="{DynamicResource SctAccentBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeDashArray" Value="3,2" />
            <Setter Property="RadiusX" Value="8" />
            <Setter Property="RadiusY" Value="8" />
        </Style>
        <Style Selector="Rectangle.tbGroupDash.active">
            <Setter Property="StrokeThickness" Value="2" />
        </Style>
        <!-- 整组把手：按住拖进上方截图工具栏＝上栏；已满 3 组时直接禁用，不让人做注定失败的事。
             高度 32 与右侧成员行严格等高（2026-09-14（三）用户回报左右不齐后统一） -->
        <Style Selector="Button.tbGrip">
            <Setter Property="Background" Value="{DynamicResource SctPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="SizeAll" />
        </Style>
        <Style Selector="Button.tbGrip:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SctAccentBrush}" />
        </Style>
        <Style Selector="Button.tbGrip:disabled">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.tbGrip:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.tbGrip:disabled /template/ ContentPresenter#PART_ContinuousPresenter">
            <Setter Property="Background" Value="{DynamicResource SctPanelBrush}" />
        </Style>
        <!-- 删除组：悬停 ✕ 已废除（2026-09-14（三））——移除只靠拖拽：成员一枚枚拖走，少于 2 枚组自动散架 -->
        <!-- ＋ 新建组：网格最后一格，尺寸由 UniformGrid 单元格决定（与同行组卡同宽同高），故不写死宽高。
             内容为居中的「加号徽标 + 文案」，默认灰、悬停整格转品牌紫。
             🔴 必须显式 Stretch 并把 Height 退回 NaN——Fluent 的 Button ControlTheme 默认自带
             HorizontalAlignment=Left / VerticalAlignment=Center，全局样式又给了 Height=32，
             不重置的话按钮会缩成内容宽、贴在格子左侧（探针实测定罪，见 2026-09-13（十））。 -->
        <Style Selector="Button.tbGroupNew">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="NaN" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextTertiaryBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tbGroupNew:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource SctAccentBrush}" />
        </Style>
        <Style Selector="Button.tbGroupNew.active">
            <Setter Property="Foreground" Value="{DynamicResource SctAccentBrush}" />
        </Style>
        <Style Selector="Button.tbGroupNew Border.tbGroupNewBadge">
            <Setter Property="Background" Value="{DynamicResource SctPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.tbGroupNew:pointerover Border.tbGroupNewBadge">
            <Setter Property="BorderBrush" Value="{DynamicResource SctAccentBrush}" />
        </Style>
        <Style Selector="Button.tbGroupNew.active Border.tbGroupNewBadge">
            <Setter Property="BorderBrush" Value="{DynamicResource SctAccentBrush}" />
        </Style>
        <Style Selector="Border#ToolbarGroupsArea.dropHint">
            <Setter Property="BorderBrush" Value="{DynamicResource SctAccentBrush}" />
        </Style>
        <Style Selector="Grid#ToolbarGroupEmpty.active Rectangle.tbGroupDash">
            <Setter Property="StrokeThickness" Value="2" />
        </Style>
        <Style Selector="Grid#ToolbarGroupEmpty.active TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SctAccentBrush}" />
        </Style>
        <!-- 成员落点行：拖东西悬在上方时整行描紫，松手前就看得见会落进哪个组。
             MinHeight 32 与左侧把手严格等高（行内 simIcon 26 + 上下 2 padding = 30，靠 MinHeight 抬齐） -->
        <Style Selector="Border.tbGroupRow">
            <Setter Property="Background" Value="{DynamicResource SctPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="Border.tbGroupRow:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SctAccentBrush}" />
        </Style>
        <Style Selector="Border.tbGroupRow.over">
            <Setter Property="BorderBrush" Value="{DynamicResource SctAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <!-- 格子右上角的移除按钮：悬停 ✕ 已废除（2026-09-14（三）），移除只靠拖拽 -->
        <!-- 组角标：右下角小三角，颜色跟随图标色 -->
        <Style Selector="Path.tbChevron">
            <Setter Property="Fill" Value="{DynamicResource SctIconBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- ════════ 截图选框样式卡：实时预览舞台 + 预设色板 ════════ -->
        <!-- 预览舞台：模拟截图遮罩下的选区。底与内容块走与主题脱钩的中灰（见 Colors.axaml 该 Token 注释），
             遮罩一盖即形成"选区外压暗、选区内透亮"的真实观感 -->
        <Style Selector="Border.previewStage">
            <Setter Property="Background" Value="{DynamicResource SctPreviewStageBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusCard}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <!-- 四向遮罩（上/下/左/右四块拼出中间镂空），色与真实截图遮罩同源 -->
        <Style Selector="Rectangle.previewMask">
            <Setter Property="Fill" Value="{DynamicResource SctPreviewMaskBrush}" />
        </Style>
        <!-- 模拟屏幕内容块：纯装饰，用来衬出遮罩的明暗反差 -->
        <Style Selector="Rectangle.previewContent">
            <Setter Property="Fill" Value="{DynamicResource SctPreviewContentBrush}" />
            <Setter Property="RadiusX" Value="4" />
            <Setter Property="RadiusY" Value="4" />
        </Style>
        <!-- 选区四角控制点 -->
        <Style Selector="Border.previewHandle">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctPreviewMaskBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusSmall}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <!-- 选区尺寸标签：浮在选区上沿外侧（遮罩面上），故用面板底 + 发丝描边保证可读 -->
        <Style Selector="Border.previewSizeTag">
            <Setter Property="Background" Value="{DynamicResource SctPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusSmall}" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="TextBlock.previewSizeText">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextSecondaryBrush}" />
        </Style>
        <!-- 色块：32×32 连续 R12 外环，24×24 连续 R10 内芯；固定 2 DIP 环与 2 DIP 空档。
             悬浮及选中只换描边，不改变尺寸、间距或曲率；取色入口消费同一套几何。 -->
        <Style Selector="Button.colorTile">
            <Setter Property="Template" Value="{StaticResource SctToolbarButtonTemplate}" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- 悬浮：中性描边环（不是灰底填充——填充会被内芯盖住、几乎看不见，环才看得出来） -->
        <Style Selector="Button.colorTile:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.colorTile:pointerover /template/ ContentPresenter#PART_ContinuousPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
        </Style>
        <!-- 选中：品牌紫环。⚠ 必须声明在 :pointerover 之后（同优先级下后声明者胜出），
             否则悬浮选中项时紫环会被上面的中性环顶掉 -->
        <Style Selector="Button.colorTile.active">
            <Setter Property="BorderBrush" Value="{DynamicResource SctAccentBrush}" />
        </Style>
        <Style Selector="Button.colorTile.active /template/ ContentPresenter#PART_ContentPresenter, Button.colorTile.active /template/ ContentPresenter#PART_ContinuousPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
        </Style>
        <!-- 悬浮在已选中项上：紫环优先（两条伪类都成立时，后声明的 active 组合胜出） -->
        <Style Selector="Button.colorTile.active:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.colorTile.active:pointerover /template/ ContentPresenter#PART_ContinuousPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
        </Style>
        <!-- 内芯实色填充：24×24 连续 R10。
             发丝描边**恒开**：浅色主题下的白块、浅灰块，深色主题下的黑块，都靠它才不与卡片底糊成一片。 -->
        <Style Selector="Border.colorTileFill">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusSegmentInner}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- 取色按钮的内芯：六色彩虹渐变（红→橙→绿→青→蓝→品红），中心嵌一枚小色块回显当前值。
             与画笔色板的取色按钮同构，只是整体放大到 24×24 -->
        <Style Selector="Border.colorTileRainbow">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusSegmentInner}" />
        </Style>
        <Style Selector="Border.colorTileRainbowPreview">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusSmall}" />
            <Setter Property="BorderBrush" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 当前色 HEX 值：**可编辑输入框**（等宽字体便于逐位比对）。
             做成带边框的实底框而非纯文本，是为了让"这里能改"一眼可见——纯文本形态下没人会去点它。
             尺寸与同页 `Border.segmentedGroup` 严格齐平（高 32 / 圆角 6 / 1px 描边），
             这样"颜色"行的输入框与"粗细"行的分段器在同一水平线上等高。
             ⚠ 用 MinWidth 不用 Width：宽度按最长的 #AARRGGBB（9 字符 × 13.5px Consolas ≈ 67）留足，
             字体替换导致更宽时长出去而不是被切（§ 关于"数值标签一律 MinWidth"的同一条原则）。 -->
        <Style Selector="TextBox.hexInput">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas, 'Cascadia Code', monospace" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextSecondaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource SctAccentBrush}" />
            <Setter Property="SelectionBrush" Value="#80797EFE" />
            <Setter Property="ToolTip.Tip" Value="输入十六进制色值（#RRGGBB 或 #AARRGGBB），回车生效" />
        </Style>

        <!-- ============ 危险操作确认浮层 ============ -->
        <!-- 清空统计、恢复含组的默认布局和卸载组件共用确认外观 -->
        <Style Selector="Border.confirmOverlay">
            <Setter Property="Background" Value="#73000000" />
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="ZIndex" Value="200" />
        </Style>
        <Style Selector="Border.confirmCard">
            <Setter Property="Background" Value="{DynamicResource SctPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusCard}" />
            <Setter Property="Padding" Value="24,20" />
            <Setter Property="MinWidth" Value="380" />
            <Setter Property="BoxShadow" Value="0 12 32 0 #40000000" />
        </Style>
        <!-- 标题栏缩小 / 关闭按钮（Button.titleIcon.titleBarBtn / .closeBtn）已上提到全局
             Themes/Controls.axaml，本窗口不再私有定义 -->

        <!-- 概览只呈现摘要与导航，通用控件继续使用共享样式。 -->
        <Style Selector="Border.overviewCard">
            <Setter Property="Background" Value="{DynamicResource SctCardFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusCard}" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BoxShadow" Value="{StaticResource SctWorkspaceCardShadow}" />
            <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.overviewCard:pointerover">
            <Setter Property="RenderTransform" Value="translate(0px, -2px)" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctBorderBrush}" />
            <Setter Property="BoxShadow" Value="{StaticResource SctWorkspaceSidebarShadow}" />
        </Style>
        <Style Selector="Window.reduceMotion Border.overviewCard">
            <Setter Property="Transitions" Value="{x:Null}" />
            <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
        </Style>
        <Style Selector="Border.overviewDependency">
            <Setter Property="Background" Value="{DynamicResource SctInputBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusCard}" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="TextBlock.overviewHeading">
            <Setter Property="Height" Value="20" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.overviewMetric">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.overviewDetail">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.overviewDetail.ready"><Setter Property="Foreground" Value="{DynamicResource SctOkBrush}" /></Style>
        <Style Selector="TextBlock.overviewDetail.busy"><Setter Property="Foreground" Value="{DynamicResource SctWorkspaceBrandTextBrush}" /></Style>
        <Style Selector="TextBlock.overviewDetail.error">
            <Setter Property="Foreground" Value="{DynamicResource SctDangerBrush}" />
        </Style>
        <Style Selector="Border.overviewWelcome.day > Grid > StackPanel > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SctSkyDayTextBrush}" />
        </Style>
        <Style Selector="Border.overviewWelcome.dusk > Grid > StackPanel > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SctSkyDuskTextBrush}" />
        </Style>
        <Style Selector="Border.overviewWelcome.night > Grid > StackPanel > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SctSkyNightTextBrush}" />
        </Style>


        <!-- 设置页浮动通知：与滚动内容同层叠放，不再占用底部常驻槽位。 -->
        <Style Selector="Border.statusBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
            <Setter Property="BoxShadow" Value="{DynamicResource SctShadowOverlay}" />
            <Setter Property="Transitions">
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="Window.reduceMotion Border.statusBar">
            <Setter Property="Transitions" Value="{x:Null}" />
        </Style>
        <Style Selector="Border.statusSurface">
            <Setter Property="Background" Value="{DynamicResource SctMenuBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctMenuBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="Border.statusBar.error Border.statusSurface">
            <Setter Property="Background" Value="{DynamicResource SctDangerBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctDangerBrush}" />
        </Style>
        <Style Selector="TextBlock.statusBarText">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Path.statusBarIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{DynamicResource SctWorkspaceBrandTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,2,10,0" />
        </Style>
        <Style Selector="Border.statusBar.error Path.statusBarIcon">
            <Setter Property="Fill" Value="{DynamicResource SctDangerBrush}" />
        </Style>
        <Style Selector="Button.statusClose">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.statusClose:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.statusClose:pointerover /template/ ContentPresenter#PART_ContinuousPresenter">
            <Setter Property="Background" Value="{DynamicResource SctRowHoverBgBrush}" />
        </Style>
        <Style Selector="Button.statusClose:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.statusClose:pressed /template/ ContentPresenter#PART_ContinuousPresenter">
            <Setter Property="Background" Value="{DynamicResource SctChoicePressedBrush}" />
        </Style>

        <!-- 搜索匹配高亮微光样式（淡紫半透明微光）。
             注意：Avalonia XAML 编译器无法对 Border/Grid/StackPanel 多类型选择器组解析 Background setter（公共类型 Control 无该属性），必须逐类型声明 -->
        <Style Selector="Border.searchMatchFlash">
            <Setter Property="Background" Value="{DynamicResource SctBadgeBgBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.searchMatchFlash">
            <Setter Property="Background" Value="{DynamicResource SctBadgeBgBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.searchMatchFlash">
            <Setter Property="Background" Value="{DynamicResource SctBadgeBgBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>

        <!-- 搜索框本体：整条右区即输入框，无圆角外壳，仅底部 2px 细线；
             常态发丝线 → 悬浮加深 → 聚焦品牌紫（focus-within 靠内嵌输入框承接焦点），
             伪类变体按优先级从低到高声明，聚焦态最后声明以便同时命中时胜出 -->
        <Style Selector="Border.searchBox">
            <Setter Property="Background" Value="{DynamicResource SctInputBgBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctSoftBorderBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.searchBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SctBorderBrush}" />
        </Style>
        <Style Selector="Border.searchBox:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource SctAccentBrush}" />
        </Style>

        <!-- 搜索栏输入框专用类：压制全局 TextBox 聚焦/悬浮模板描边（全局会给模板 Border
             强制 1px 紫描边 + SctInputBgBrush 底色 + 圆角 8，即搜索栏上残留的圆角矩形），
             三态全部压平为透明无框，聚焦反馈由外层 Border.searchBox 底部细线承担 -->
        <Style Selector="TextBox.searchInput">
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TextBox.searchInput:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.searchInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.searchInput:focus:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Grid.fieldRow &gt; StackPanel.fieldInfo">
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.fieldRow &gt; TextBlock.fieldLabel">
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.settingsNavGroup">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextMutedBrush}" />
            <Setter Property="Margin" Value="12,6,0,3" />
        </Style>
        <Style Selector="Border.settingsSidebar">
            <Setter Property="Background" Value="{DynamicResource SctWorkspaceSidebarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusCard}" />
            <Setter Property="BoxShadow" Value="{StaticResource SctWorkspaceSidebarShadow}" />
        </Style>
    </Window.Styles>

    <!-- 新主题外壳：悬浮侧栏、环境光与固定页面工具条。 -->
    <controls:ContinuousBorder ClipToBounds="True">
        <Grid RowDefinitions="36,*">
            <controls:ContinuousBorder PointerPressed="OnTitleBarPointerPressed" Background="Transparent">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="20,0" VerticalAlignment="Center">
                        <TextBlock Text="yuSnip" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="/" FontSize="12" Foreground="{DynamicResource SctTextMutedBrush}" />
                        <TextBlock Text="设置" FontSize="12" Foreground="{DynamicResource SctTextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
                        <Button Classes="titleIcon titleBarBtn" ToolTip.Tip="最小化" AutomationProperties.Name="最小化" Click="OnMinimizeClick">
                            <Path Classes="workspaceIcon" Data="{x:Static win:WorkspaceIconGeometry.Minimize}" Width="12" Height="1" Fill="{DynamicResource SctTextMutedBrush}" StrokeThickness="0" />
                        </Button>
                        <Button Classes="titleIcon titleBarBtn closeBtn" ToolTip.Tip="关闭" AutomationProperties.Name="关闭设置" Click="OnCloseClick">
                            <Path Classes="workspaceIcon" Data="{x:Static win:WorkspaceIconGeometry.Close}" Width="12" Height="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </controls:ContinuousBorder>
            <Grid Grid.Row="1" ColumnDefinitions="224,*">
                <Ellipse Grid.Column="1" Width="640" Height="380" Margin="0,-140,-140,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource SctWorkspaceGlowBrush}" IsHitTestVisible="False" />
                <controls:ContinuousBorder Classes="settingsSidebar" Margin="12,8,8,12">
                    <Grid RowDefinitions="76,*,52">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="20,0" VerticalAlignment="Center">
                            <Image x:Name="ImgSidebarLogo" Source="/Assets/Black.ico" Width="30" Height="30" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="yuSnip" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="让灵感，随手留存" FontSize="10.5" Foreground="{DynamicResource SctTextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer x:Name="SidebarNavScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,0,10,8" Spacing="2">
                            <Button x:Name="BtnNavOverview" Classes="nav active" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnNavOverviewClick" AutomationProperties.Name="概览">
                                <Grid ColumnDefinitions="16,10,*,10,3">
                                    <Path Classes="workspaceIcon" Data="{x:Static win:WorkspaceIconGeometry.Overview}" />
                                    <TextBlock Grid.Column="2" Text="概览" FontSize="13" VerticalAlignment="Center" />
                                    <controls:ContinuousBorder Grid.Column="4" Classes="navIndicator" Width="3" Height="14" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctAccentBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <TextBlock Text="常用设置" Classes="settingsNavGroup" />
                            <Button x:Name="BtnNavBasic" Classes="nav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnNavBasicClick" AutomationProperties.Name="通用与存储">
                                <Grid ColumnDefinitions="16,10,*,10,3">
                                    <Path Classes="workspaceIcon" Data="{x:Static win:WorkspaceIconGeometry.General}" />
                                    <TextBlock Grid.Column="2" Text="通用与存储" FontSize="13" VerticalAlignment="Center" />
                                    <controls:ContinuousBorder Grid.Column="4" Classes="navIndicator" Width="3" Height="14" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctAccentBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="BtnNavInteract" Classes="nav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnNavInteractClick" AutomationProperties.Name="交互与行为">
                                <Grid ColumnDefinitions="16,10,*,10,3">
                                    <Path Classes="workspaceIcon" Data="{x:Static win:WorkspaceIconGeometry.Pointer}" />
                                    <TextBlock Grid.Column="2" Text="交互与行为" FontSize="13" VerticalAlignment="Center" />
                                    <controls:ContinuousBorder Grid.Column="4" Classes="navIndicator" Width="3" Height="14" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctAccentBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="BtnNavAnnot" Classes="nav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnNavAnnotClick" AutomationProperties.Name="标注">
                                <Grid ColumnDefinitions="16,10,*,10,3">
                                    <Path Classes="workspaceIcon" Data="{x:Static win:WorkspaceIconGeometry.Pen}" />
                                    <TextBlock Grid.Column="2" Text="标注" FontSize="13" VerticalAlignment="Center" />
                                    <controls:ContinuousBorder Grid.Column="4" Classes="navIndicator" Width="3" Height="14" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctAccentBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="BtnNavActions" Classes="nav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnNavActionsClick" AutomationProperties.Name="快捷键与动作">
                                <Grid ColumnDefinitions="16,10,*,10,3">
                                    <Path Classes="workspaceIcon" Data="{x:Static win:WorkspaceIconGeometry.Keyboard}" />
                                    <TextBlock Grid.Column="2" Text="快捷键与动作" FontSize="13" VerticalAlignment="Center" />
                                    <controls:ContinuousBorder Grid.Column="4" Classes="navIndicator" Width="3" Height="14" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctAccentBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="BtnNavToolbar" Classes="nav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnNavToolbarClick" AutomationProperties.Name="工具栏与样式">
                                <Grid ColumnDefinitions="16,10,*,10,3">
                                    <Path Classes="workspaceIcon" Data="{x:Static win:WorkspaceIconGeometry.Sliders}" />
                                    <TextBlock Grid.Column="2" Text="工具栏与样式" FontSize="13" VerticalAlignment="Center" />
                                    <controls:ContinuousBorder Grid.Column="4" Classes="navIndicator" Width="3" Height="14" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctAccentBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <TextBlock Text="扩展能力" Classes="settingsNavGroup" />
                            <Button x:Name="BtnNavTranslate" Classes="nav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnNavTranslateClick" AutomationProperties.Name="OCR 与翻译">
                                <Grid ColumnDefinitions="16,10,*,10,3">
                                    <Path Classes="workspaceIcon" Data="{x:Static win:WorkspaceIconGeometry.Translate}" />
                                    <TextBlock Grid.Column="2" Text="OCR 与翻译" FontSize="13" VerticalAlignment="Center" />
                                    <controls:ContinuousBorder Grid.Column="4" Classes="navIndicator" Width="3" Height="14" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctAccentBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="BtnNavAi" Classes="nav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnNavAiClick" AutomationProperties.Name="AI 模型">
                                <Grid ColumnDefinitions="16,10,*,10,3">
                                    <Path Classes="workspaceIcon" Data="{x:Static win:WorkspaceIconGeometry.Robot}" />
                                    <TextBlock Grid.Column="2" Text="AI 模型" FontSize="13" VerticalAlignment="Center" />
                                    <controls:ContinuousBorder Grid.Column="4" Classes="navIndicator" Width="3" Height="14" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctAccentBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="BtnNavCloudSync" Classes="nav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnNavCloudSyncClick" AutomationProperties.Name="云存储配置">
                                <Grid ColumnDefinitions="16,10,*,10,3">
                                    <Path Classes="workspaceIcon" Data="{x:Static win:WorkspaceIconGeometry.Cloud}" />
                                    <TextBlock Grid.Column="2" Text="云存储配置" FontSize="13" VerticalAlignment="Center" />
                                    <controls:ContinuousBorder Grid.Column="4" Classes="navIndicator" Width="3" Height="14" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctAccentBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="BtnNavDeps" Classes="nav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnNavDepsClick" AutomationProperties.Name="依赖运行">
                                <Grid ColumnDefinitions="16,10,*,10,3">
                                    <Path Classes="workspaceIcon" Data="{x:Static win:WorkspaceIconGeometry.Package}" />
                                    <TextBlock Grid.Column="2" Text="依赖运行" FontSize="13" VerticalAlignment="Center" />
                                    <controls:ContinuousBorder Grid.Column="4" Classes="navIndicator" Width="3" Height="14" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctAccentBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <TextBlock Text="更多" Classes="settingsNavGroup" />
                            <Button x:Name="BtnNavStats" Classes="nav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnNavStatsClick" AutomationProperties.Name="使用统计">
                                <Grid ColumnDefinitions="16,10,*,10,3">
                                    <Path Classes="workspaceIcon" Data="{x:Static win:WorkspaceIconGeometry.Chart}" />
                                    <TextBlock Grid.Column="2" Text="使用统计" FontSize="13" VerticalAlignment="Center" />
                                    <controls:ContinuousBorder Grid.Column="4" Classes="navIndicator" Width="3" Height="14" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctAccentBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="BtnNavAbout" Classes="nav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnNavAboutClick" AutomationProperties.Name="关于">
                                <Grid ColumnDefinitions="16,10,*,10,3">
                                    <Path Classes="workspaceIcon" Data="{x:Static win:WorkspaceIconGeometry.Info}" />
                                    <TextBlock Grid.Column="2" Text="关于" FontSize="13" VerticalAlignment="Center" />
                                    <controls:ContinuousBorder Grid.Column="4" Classes="navIndicator" Width="3" Height="14" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctAccentBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            </StackPanel>
                        </ScrollViewer>
                        <controls:ContinuousBorder Grid.Row="2" BorderBrush="{DynamicResource SctSoftBorderBrush}" BorderThickness="0,1,0,0" Margin="22,0,16,0">
                            <Grid ColumnDefinitions="16,10,*" VerticalAlignment="Center">
                                <Path x:Name="IconSettingsAutoSave" Classes="workspaceIcon" Data="{x:Static win:WorkspaceIconGeometry.Check}" />
                                <TextBlock Grid.Column="2" Text="设置更改自动保存" FontSize="11" Foreground="{DynamicResource SctTextMutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </controls:ContinuousBorder>
                    </Grid>
                </controls:ContinuousBorder>
                <Grid Grid.Column="1" RowDefinitions="58,*" Margin="0,0,12,12">
                    <Grid ColumnDefinitions="*,320" Margin="28,0,28,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="设置" FontSize="12" Foreground="{DynamicResource SctTextMutedBrush}" />
                            <Path Classes="workspaceIcon" Width="8" Height="8" Data="{x:Static win:WorkspaceIconGeometry.ChevronRight}" />
                            <TextBlock x:Name="TxtPageBreadcrumb" Text="通用与存储" FontSize="12" />
                        </StackPanel>
                        <controls:ContinuousBorder x:Name="BorderSearchField" Grid.Column="1" Classes="searchBox" BorderThickness="1" Height="34" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="16,8,*,8,Auto" Margin="10,0">
                                <Path Classes="workspaceIcon" Width="14" Height="14" Data="{x:Static win:WorkspaceIconGeometry.Search}" />
                                <TextBox x:Name="TxtSearchBox" Grid.Column="2" Classes="searchInput" Background="Transparent" BorderThickness="0" Padding="0" FontSize="12" Watermark="搜索设置…" AutomationProperties.Name="搜索设置" VerticalContentAlignment="Center" TextChanged="OnSearchBoxTextChanged" KeyDown="OnSearchBoxKeyDown" GotFocus="OnSearchBoxGotFocus" />
                                <TextBlock Grid.Column="4" Text="Ctrl K" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource SctTextMutedBrush}" IsHitTestVisible="False" />
                            </Grid>
                        </controls:ContinuousBorder>
                        <Popup x:Name="SearchResultPopup" WindowManagerAddShadowHint="False" Placement="BottomEdgeAlignedRight" VerticalOffset="8" PlacementTarget="{Binding #BorderSearchField}" IsLightDismissEnabled="True" IsOpen="False" Closed="OnSearchPopupClosed">
                            <controls:ContinuousBorder Classes="searchResultPanel">
                                <StackPanel>
                                    <StackPanel x:Name="SearchResultHeaderList" />
                                    <ScrollViewer MaxHeight="264" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="SearchResultList" />
                                    </ScrollViewer>
                                </StackPanel>
                            </controls:ContinuousBorder>
                        </Popup>
                    </Grid>
                    <ScrollViewer Grid.Row="1" x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnMainScrollChanged">
                        <StackPanel x:Name="SettingsPages" Margin="28,14,28,28" Spacing="0">

                            <!-- ============ 概览：只读摘要与既有设置入口 ============ -->
                            <Grid x:Name="PanelOverview" ColumnDefinitions="1.4*,*">
                                <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,16,0">
                                    <controls:ContinuousBorder x:Name="OverviewWelcome" Classes="overviewCard overviewWelcome day" Padding="0" Height="200">
                                        <Grid>
                                            <controls:OverviewSky x:Name="SkyOverview" IsHitTestVisible="False" />
                                            <StackPanel Spacing="10" Margin="24" VerticalAlignment="Top">
                                                <TextBlock x:Name="TxtOverviewGreeting" Text="你好！" FontSize="30" FontWeight="Bold" />
                                                <TextBlock x:Name="TxtOverviewSkyNote" FontSize="13" TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button x:Name="BtnOverviewGitHub" Classes="secondary actionSurface" Content="GitHub" Click="OnOpenGitHubClick"  />
                                                    <Button x:Name="BtnOverviewWebsite" Classes="secondary actionSurface" Content="官网" Click="OnOpenWebsiteClick"  Margin="10,0,0,0" />
                                                </WrapPanel>
                                            </StackPanel>
                                            <StackPanel x:Name="OverviewWeatherPanel" Classes="weatherReading" Spacing="7" Margin="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="180">
                                                <TextBlock x:Name="TxtOverviewWeather" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" IsVisible="False" />
                                                <Button x:Name="BtnOverviewRegion" Classes="secondary actionSurface weatherAction" MaxWidth="180" Click="OnWeatherPickerClick" HorizontalAlignment="Right">
                                                    <TextBlock x:Name="TxtOverviewRegion" Text="选择地区 · 添加天气" TextTrimming="CharacterEllipsis" MaxWidth="168" />
                                                </Button>
                                                <TextBlock x:Name="TxtWeatherAttribution" FontSize="10" Height="14" Text="Open-Meteo" IsVisible="False" HorizontalAlignment="Right" Cursor="Arrow" />
                                            </StackPanel>
                                        </Grid>
                                    </controls:ContinuousBorder>
                                    <controls:ContinuousBorder Classes="overviewCard" Padding="20,6">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="今日使用" Classes="sectionTitle overviewHeading" /><Button Grid.Column="1" Classes="secondary actionSurface" Content="详情" Tag="Stats" Click="OnOverviewNavigateClick" /></Grid>
                                            <UniformGrid Columns="5">
                                                <StackPanel Spacing="4"><TextBlock x:Name="TxtOverviewScreenshot" Text="—" Classes="overviewMetric" Foreground="{DynamicResource SctTextPrimaryBrush}" /><TextBlock Text="截图" Classes="overviewDetail" /></StackPanel>
                                                <StackPanel Spacing="4"><TextBlock x:Name="TxtOverviewOcr" Text="—" Classes="overviewMetric" Foreground="{DynamicResource SctTextPrimaryBrush}" /><TextBlock Text="OCR" Classes="overviewDetail" /></StackPanel>
                                                <StackPanel Spacing="4"><TextBlock x:Name="TxtOverviewTranslate" Text="—" Classes="overviewMetric" Foreground="{DynamicResource SctTextPrimaryBrush}" /><TextBlock Text="翻译" Classes="overviewDetail" /></StackPanel>
                                                <StackPanel Spacing="4"><TextBlock x:Name="TxtOverviewAi" Text="—" Classes="overviewMetric" Foreground="{DynamicResource SctTextPrimaryBrush}" /><TextBlock Text="AI 对话" Classes="overviewDetail" /></StackPanel>
                                                <StackPanel Spacing="4"><TextBlock x:Name="TxtOverviewSticker" Text="—" Classes="overviewMetric" Foreground="{DynamicResource SctTextPrimaryBrush}" /><TextBlock Text="贴图" Classes="overviewDetail" /></StackPanel>
                                            </UniformGrid>
                                            <TextBlock x:Name="TxtOverviewDate" Classes="overviewDetail" FontSize="11" />
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                    <controls:ContinuousBorder Classes="overviewCard">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="近 7 天使用趋势" Classes="sectionTitle overviewHeading" /><Button Grid.Column="1" Classes="secondary actionSurface" Content="完整统计" Tag="Stats" Click="OnOverviewNavigateClick" /></Grid>
                                            <controls:UsageChart x:Name="ChartOverview" Height="140" IsAreaChart="True" />
                                            <WrapPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,12,0"><Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{DynamicResource SctChartSeries1Brush}" /><TextBlock Text="截图" Classes="overviewDetail" /></StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,12,0"><Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{DynamicResource SctChartSeries2Brush}" /><TextBlock Text="AI" Classes="overviewDetail" /></StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,12,0"><Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{DynamicResource SctChartSeries3Brush}" /><TextBlock Text="OCR" Classes="overviewDetail" /></StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,12,0"><Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{DynamicResource SctChartSeries4Brush}" /><TextBlock Text="翻译" Classes="overviewDetail" /></StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,12,0"><Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{DynamicResource SctChartSeries5Brush}" /><TextBlock Text="贴图" Classes="overviewDetail" /></StackPanel>
                                            </WrapPanel>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="16">
                                    <Grid ColumnDefinitions="*,*">
                                        <controls:ContinuousBorder Classes="overviewCard" Padding="16" Margin="0,0,8,0" Height="156">
                                            <Grid RowDefinitions="24,*,32">
                                                <StackPanel Orientation="Horizontal" Spacing="8"><Image x:Name="ImgOverviewLogo" Source="/Assets/Black.ico" Width="24" Height="24" /><TextBlock Text="yuSnip" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                                                <StackPanel Grid.Row="1" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtOverviewVersion" Text="—" Classes="overviewDetail" />
                                                    <TextBlock x:Name="TxtOverviewUpdate" Text="尚未检查" Classes="overviewDetail" />
                                                </StackPanel>
                                                <Button Grid.Row="2" x:Name="BtnOverviewUpdate" Classes="secondary actionSurface" Content="检查更新" Click="OnOverviewUpdateClick" HorizontalAlignment="Left" />
                                            </Grid>
                                        </controls:ContinuousBorder>
                                        <controls:ContinuousBorder Grid.Column="1" Classes="overviewCard" Padding="16" Margin="8,0,0,0" Height="156">
                                            <Grid RowDefinitions="24,*,32">
                                                <TextBlock Text="运行依赖" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtOverviewDepsCount" Text="— / 3" Classes="overviewMetric" Foreground="{DynamicResource SctWorkspaceBrandTextBrush}" />
                                                    <TextBlock x:Name="TxtOverviewDepsState" Text="读取状态中" Classes="overviewDetail" />
                                                </StackPanel>
                                                <Button Grid.Row="2" x:Name="BtnOverviewManageDeps" Classes="secondary actionSurface" Content="管理依赖" Tag="Deps" Click="OnOverviewNavigateClick" HorizontalAlignment="Left" />
                                            </Grid>
                                        </controls:ContinuousBorder>
                                    </Grid>
                                    <controls:ContinuousBorder Classes="overviewCard" Padding="20,16">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="运行组件" Classes="sectionTitle overviewHeading" /><Button Grid.Column="1" Classes="secondary actionSurface" Content="管理" Tag="Deps" Click="OnOverviewNavigateClick" /></Grid>
                                            <TextBlock Text="按需安装，启用对应功能。" Classes="overviewDetail" />
                                            <StackPanel x:Name="OverviewDependencies" Spacing="12" />
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                </StackPanel>
                            </Grid>

                            <!-- ============ 通用与存储 ============ -->
                            <StackPanel x:Name="PanelBasic" Spacing="24">
                                <StackPanel Spacing="8" Margin="0,0,0,4">
                                    <TextBlock Text="通用与存储" Classes="pageTitle" />
                                    <TextBlock Text="启动行为、通知提示与文件保存选项。" Classes="pageDescription" />
                                </StackPanel>

                                <controls:ContinuousBorder Classes="card">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="界面外观" Classes="sectionTitle" />
                                        <TextBlock Text="选择适合当前环境的外观，切换后立即生效。" Classes="fieldHint" />
                                        <Grid ColumnDefinitions="*,12,*,12,*">
                                            <RadioButton x:Name="RadThemeLight" Grid.Column="0" GroupName="GrpTheme" Classes="themeTile" IsCheckedChanged="OnThemeChanged" AutomationProperties.Name="浅色主题">
                                                <StackPanel Spacing="10">
                                                    <controls:ContinuousBorder Height="52" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctWorkspaceSampleLightCanvasBrush}" BorderBrush="{DynamicResource SctWorkspaceSampleLightLineBrush}" BorderThickness="1" Padding="5">
                                                        <Grid ColumnDefinitions="24,6,*">
                                                            <controls:ContinuousBorder CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctWorkspaceSampleLightSidebarBrush}" />
                                                            <StackPanel Grid.Column="2" Spacing="5" Margin="0,3">
                                                                <controls:ContinuousBorder Height="5" Width="38" HorizontalAlignment="Left" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctAccentBrush}" />
                                                                <controls:ContinuousBorder Height="19" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctWorkspaceSampleLightCardBrush}" BorderBrush="{DynamicResource SctWorkspaceSampleLightLineBrush}" BorderThickness="1" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </controls:ContinuousBorder>
                                                    <TextBlock Text="浅色" HorizontalAlignment="Center" FontSize="12" />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="RadThemeDark" Grid.Column="2" GroupName="GrpTheme" Classes="themeTile" IsCheckedChanged="OnThemeChanged" AutomationProperties.Name="深色主题">
                                                <StackPanel Spacing="10">
                                                    <controls:ContinuousBorder Height="52" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctWorkspaceSampleDarkCanvasBrush}" BorderBrush="{DynamicResource SctWorkspaceSampleDarkLineBrush}" BorderThickness="1" Padding="5">
                                                        <Grid ColumnDefinitions="24,6,*">
                                                            <controls:ContinuousBorder CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctWorkspaceSampleDarkSidebarBrush}" />
                                                            <StackPanel Grid.Column="2" Spacing="5" Margin="0,3">
                                                                <controls:ContinuousBorder Height="5" Width="38" HorizontalAlignment="Left" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctAccentBrush}" />
                                                                <controls:ContinuousBorder Height="19" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctWorkspaceSampleDarkCardBrush}" BorderBrush="{DynamicResource SctWorkspaceSampleDarkLineBrush}" BorderThickness="1" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </controls:ContinuousBorder>
                                                    <TextBlock Text="深色" HorizontalAlignment="Center" FontSize="12" />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="RadThemeSystem" Grid.Column="4" GroupName="GrpTheme" Classes="themeTile" IsCheckedChanged="OnThemeChanged" AutomationProperties.Name="跟随系统主题">
                                                <StackPanel Spacing="10">
                                                    <controls:ContinuousBorder Height="52" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctWorkspaceSampleLightCanvasBrush}" BorderBrush="{DynamicResource SctWorkspaceSampleLightLineBrush}" BorderThickness="1" Padding="5">
                                                        <Grid ColumnDefinitions="24,6,*">
                                                            <controls:ContinuousBorder CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctWorkspaceSampleDarkSidebarBrush}" />
                                                            <StackPanel Grid.Column="2" Spacing="5" Margin="0,3">
                                                                <controls:ContinuousBorder Height="5" Width="38" HorizontalAlignment="Left" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctAccentBrush}" />
                                                                <controls:ContinuousBorder Height="19" CornerRadius="{DynamicResource SctRadiusSmall}" Background="{DynamicResource SctWorkspaceSampleLightCardBrush}" BorderBrush="{DynamicResource SctWorkspaceSampleLightLineBrush}" BorderThickness="1" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </controls:ContinuousBorder>
                                                    <TextBlock Text="跟随系统" HorizontalAlignment="Center" FontSize="12" />
                                                </StackPanel>
                                            </RadioButton>
                                        </Grid>
                                    </StackPanel>
                                </controls:ContinuousBorder>
                                <controls:ContinuousBorder Classes="card">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="启动与通知" Classes="sectionTitle" />

                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="开机启动" Classes="fieldLabel" />
                                                <TextBlock Text="开机自动启动 yuSnip；管理员模式开启时自动改走计划任务提权启动。" Classes="fieldHint" />
                                            </StackPanel>
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadRunOnStartupOff" GroupName="GrpRunOnStartup" Classes="segmented" Content="关闭" />
                                                    <RadioButton x:Name="RadRunOnStartupOn" GroupName="GrpRunOnStartup" Classes="segmented" Content="开启" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>
                                        <controls:ContinuousBorder Classes="softDivider" />

                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="管理员模式" Classes="fieldLabel" />
                                                <TextBlock x:Name="TxtElevationHint" Classes="fieldHint" Text="始终以管理员权限运行，快捷键不再被任务管理器等高权限窗口挡住；开机自启改走计划任务，免每次 UAC。" />
                                            </StackPanel>
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadAdminModeOff" GroupName="GrpAdminMode" Classes="segmented" Content="关闭" />
                                                    <RadioButton x:Name="RadAdminModeOn" GroupName="GrpAdminMode" Classes="segmented" Content="开启" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>
                                        <controls:ContinuousBorder Classes="softDivider" />

                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="保存成功后显示通知" Classes="fieldLabel" />
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadShowSaveNotificationOff" GroupName="GrpShowSaveNotification" Classes="segmented" Content="关闭" />
                                                    <RadioButton x:Name="RadShowSaveNotificationOn" GroupName="GrpShowSaveNotification" Classes="segmented" Content="开启" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>
                                        <controls:ContinuousBorder Classes="softDivider" />

                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="启动时显示提示" Classes="fieldLabel" />
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadShowStartupNotificationOff" GroupName="GrpShowStartupNotification" Classes="segmented" Content="关闭" />
                                                    <RadioButton x:Name="RadShowStartupNotificationOn" GroupName="GrpShowStartupNotification" Classes="segmented" Content="开启" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>
                                        <controls:ContinuousBorder Classes="softDivider" />
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="保存时播放提示音" Classes="fieldLabel" />
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadPlaySaveSoundOff" GroupName="GrpPlaySaveSound" Classes="segmented" Content="关闭" />
                                                    <RadioButton x:Name="RadPlaySaveSoundOn" GroupName="GrpPlaySaveSound" Classes="segmented" Content="开启" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>
                                    </StackPanel>
                                </controls:ContinuousBorder>

                                <controls:ContinuousBorder Classes="card">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="文件与存储" Classes="sectionTitle" />
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="截图保存目录" Classes="secondary" />
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <TextBox x:Name="TxtSaveDirectory" Grid.Column="0" Watermark="例如：%USERPROFILE%\Pictures\Screenshots" />
                                                <Button Grid.Column="1" Content="浏览…" MinWidth="76" Margin="8,0,0,0" Classes="primary" Click="OnBrowseSaveDirectoryClick" />
                                                <Button Grid.Column="2" Content="打开" MinWidth="76" Margin="8,0,0,0" Classes="secondary" Click="OnOpenSaveDirectoryClick" />
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="录屏保存目录" Classes="secondary" />
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <TextBox x:Name="TxtRecSaveDir" Grid.Column="0" Watermark="留空则用 视频\yuSnip 录屏" />
                                                <Button x:Name="BtnBrowseRecSaveDir" Grid.Column="1" Content="浏览…" MinWidth="76" Margin="8,0,0,0" Classes="primary" Click="OnBrowseRecSaveDirClick" />
                                                <Button Grid.Column="2" Content="打开" MinWidth="76" Margin="8,0,0,0" Classes="secondary" Click="OnOpenRecSaveDirClick" />
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="文件名模板" Classes="secondary" />
                                            <TextBox x:Name="TxtFileNameTemplate" Watermark="Screenshot_{yyyyMMdd_HHmmss}" />
                                            <TextBlock Text="支持 {yyyyMMdd_HHmmss} 等时间占位符。" Classes="fieldHint" />
                                        </StackPanel>

                                        <controls:ContinuousBorder Classes="softDivider" />

                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="截图保存后自动复制到剪贴板" Classes="fieldLabel" />
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadCopyToClipboardOff" GroupName="GrpCopyToClipboard" Classes="segmented" Content="关闭" />
                                                    <RadioButton x:Name="RadCopyToClipboardOn" GroupName="GrpCopyToClipboard" Classes="segmented" Content="开启" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>
                                    </StackPanel>
                                </controls:ContinuousBorder>

                                <!-- 截图历史：开启后全量留存产出图片（含普通截图、贴图、长截图）。
                                     默认关闭——收集会往 %APPDATA% 写入图片副本，属磁盘写入行为，不擅自默认开。 -->
                                <controls:ContinuousBorder Classes="card">
                                    <StackPanel Spacing="10">
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="截图历史" Classes="fieldLabel" />
                                                <TextBlock Text="产出图片留本机副本，在托盘菜单「截图历史」里回看与再次使用。" Classes="fieldHint" />
                                            </StackPanel>
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadHistoryOff" GroupName="GrpCaptureHistory" Classes="segmented" Content="关闭" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadHistoryOn" GroupName="GrpCaptureHistory" Classes="segmented" Content="开启" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>
                                        <controls:ContinuousBorder Classes="softDivider" />

                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="截图自动识别文字" Classes="fieldLabel" />
                                                <TextBlock Text="截图产出后后台静默识别文字，供历史关键字检索（会增加后台占用）。" Classes="fieldHint" />
                                            </StackPanel>
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadCaptureAutoOcrOff" GroupName="GrpCaptureAutoOcr" Classes="segmented" Content="关闭" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadCaptureAutoOcrOn" GroupName="GrpCaptureAutoOcr" Classes="segmented" Content="开启" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>

                                        <controls:ContinuousBorder Classes="softDivider" />

                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="历史存储" Classes="fieldLabel" />
                                                <TextBlock x:Name="TxtHistoryUsage" Classes="fieldHint" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button x:Name="BtnHistoryOpen" Content="查看历史" MinWidth="88" Click="OnHistoryOpenClick" />
                                                <Button x:Name="BtnHistoryClear" Content="清空历史" MinWidth="88" Click="OnHistoryClearClick" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </controls:ContinuousBorder>
                            </StackPanel>


                            <!-- ============ 交互与行为（截图 / 贴图 / 录屏 / 抠图 四栏，顶部分段条切换） ============ -->
                            <StackPanel x:Name="PanelInteract" Spacing="24" IsVisible="False">
                                <StackPanel Spacing="8" Margin="0,0,0,4">
                                    <TextBlock Text="交互与行为" Classes="pageTitle" />
                                    <TextBlock Text="截图、贴图、录屏与抠图各自的操作体验。" Classes="pageDescription" />
                                </StackPanel>

                                <!-- 顶部分栏导航：与「快捷键与动作」页同一套 segmentedGroup / segmented 现成样式，不新造第二种分栏形态 -->
                                <controls:ContinuousBorder Classes="segmentedGroup" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RadInteractTabCapture" GroupName="GrpInteractTabs" Classes="segmented" Content="截图" IsChecked="True" IsCheckedChanged="OnInteractTabSelectionChanged" />
                                        <Rectangle Classes="segmentedDivider" />
                                        <RadioButton x:Name="RadInteractTabSticker" GroupName="GrpInteractTabs" Classes="segmented" Content="贴图" IsCheckedChanged="OnInteractTabSelectionChanged" />
                                        <Rectangle Classes="segmentedDivider" />
                                        <RadioButton x:Name="RadInteractTabRecord" GroupName="GrpInteractTabs" Classes="segmented" Content="录屏" IsCheckedChanged="OnInteractTabSelectionChanged" />
                                        <Rectangle Classes="segmentedDivider" />
                                        <RadioButton x:Name="RadInteractTabMatting" GroupName="GrpInteractTabs" Classes="segmented" Content="抠图" IsCheckedChanged="OnInteractTabSelectionChanged" />
                                    </StackPanel>
                                </controls:ContinuousBorder>

                                <!-- 视图 1：截图栏 -->
                                <StackPanel x:Name="PnlInteractCapture" Spacing="24">
                                    <controls:ContinuousBorder Classes="card">
                                        <StackPanel Spacing="10">
                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="自动检测模式" Classes="fieldLabel" />
                                                    <TextBlock Text="控制截图时鼠标自动吸附窗口或内部元素的行为。" Classes="fieldHint" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadAutoDetectElement" GroupName="GrpAutoDetect" Classes="segmented" Content="检测元素" IsCheckedChanged="OnRadAutoDetectElementCheckedChanged" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadAutoDetectWindow" GroupName="GrpAutoDetect" Classes="segmented" Content="仅窗口" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadAutoDetectNone" GroupName="GrpAutoDetect" Classes="segmented" Content="不检测" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>

                                            <!-- 「检测元素」悬停检测参数：仅检测元素模式可见，双值仪表盘排版（方案A）
                                                 左右对称单元格 + 中缝发丝分隔线；每格 = 顶行(参数名 + 可点击编辑的大数值) / 说明 /
                                                 固定尺寸格子条（40 格 × 4×20px 宽高比 1:5，每格步进 2.5，对标 PSexp 质量滑块；精确值可点大数值输入）/ 刻度行。 -->
                                            <controls:ContinuousBorder x:Name="PnlElementDwell" IsVisible="False"
                                                    Background="{DynamicResource SctSubtleBrush}"
                                                    BorderBrush="{DynamicResource SctSoftBorderBrush}"
                                                    BorderThickness="1" CornerRadius="{DynamicResource SctRadiusCard}" Padding="2,6">
                                                <Grid ColumnDefinitions="*,Auto,*">
                                                    <!-- 触发延时 -->
                                                    <StackPanel Grid.Column="0" Spacing="3" Margin="12,2">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="触发延时" Classes="fieldLabel"
                                                                       VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                                                <TextBox x:Name="TxtDwellMs" Classes="bigVal" Text="10" MinWidth="40"
                                                                         TextInput="OnTxtDwellMsTextInput"
                                                                         KeyDown="OnTxtDwellMsKeyDown" LostFocus="OnTxtDwellMsLostFocus" />
                                                                <TextBlock Text="ms" FontSize="11" Margin="0,0,0,2"
                                                                           Foreground="{DynamicResource SctTextMutedBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Text="鼠标停下后多久检测元素。越小越灵敏，越大越防抖。" Classes="fieldHint" />
                                                        <controls:NotchedSlider x:Name="NsdElementDwellMs" ShowInput="False"
                                                                                Minimum="0" Maximum="100" CellCount="40" />
                                                        <Grid ColumnDefinitions="*,*,*">
                                                            <TextBlock Text="0" FontSize="10" Opacity="0.7"
                                                                       Foreground="{DynamicResource SctTextMutedBrush}" />
                                                            <TextBlock Grid.Column="1" Text="50" FontSize="10" Opacity="0.7"
                                                                       HorizontalAlignment="Center"
                                                                       Foreground="{DynamicResource SctTextMutedBrush}" />
                                                            <TextBlock Grid.Column="2" Text="100" FontSize="10" Opacity="0.7"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="{DynamicResource SctTextMutedBrush}" />
                                                        </Grid>
                                                    </StackPanel>

                                                    <Rectangle Grid.Column="1" Width="1" Margin="0,2"
                                                               Fill="{DynamicResource SctSeparatorBrush}" />

                                                    <!-- 移动幅度 -->
                                                    <StackPanel Grid.Column="2" Spacing="3" Margin="12,2">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="移动幅度" Classes="fieldLabel"
                                                                       VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                                                <TextBox x:Name="TxtDwellDeadband" Classes="bigVal" Text="20" MinWidth="40"
                                                                         TextInput="OnTxtDwellDeadbandTextInput"
                                                                         KeyDown="OnTxtDwellDeadbandKeyDown" LostFocus="OnTxtDwellDeadbandLostFocus" />
                                                                <TextBlock Text="px" FontSize="11" Margin="0,0,0,2"
                                                                           Foreground="{DynamicResource SctTextMutedBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Text="忽略小幅移动的范围。鼠标微调小于该距离时不重新检测。" Classes="fieldHint" />
                                                        <controls:NotchedSlider x:Name="NsdElementDwellDeadband" ShowInput="False"
                                                                                Minimum="0" Maximum="100" CellCount="40" />
                                                        <Grid ColumnDefinitions="*,*,*">
                                                            <TextBlock Text="0" FontSize="10" Opacity="0.7"
                                                                       Foreground="{DynamicResource SctTextMutedBrush}" />
                                                            <TextBlock Grid.Column="1" Text="50" FontSize="10" Opacity="0.7"
                                                                       HorizontalAlignment="Center"
                                                                       Foreground="{DynamicResource SctTextMutedBrush}" />
                                                            <TextBlock Grid.Column="2" Text="100" FontSize="10" Opacity="0.7"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="{DynamicResource SctTextMutedBrush}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </controls:ContinuousBorder>

                                            <controls:ContinuousBorder Classes="softDivider" />

                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="截图辅助线" Classes="fieldLabel" />
                                                    <TextBlock Text="截图时显示紫色参考线：起框前对齐窗口/元素，起框后对齐选区自身。" Classes="fieldHint" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadGuidelineModeOff" GroupName="GrpGuidelineMode" Classes="segmented" Content="关闭" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadGuidelineModeHoldAlt" GroupName="GrpGuidelineMode" Classes="segmented" Content="开启" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadGuidelineModeAlways" GroupName="GrpGuidelineMode" Classes="segmented" Content="始终显示" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="softDivider" />

                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="十字准星" Classes="fieldLabel" />
                                                    <TextBlock Text="跟随鼠标、贯穿整屏的十字线与瞄准光标，起框后自动消失。" Classes="fieldHint" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadCrosshairModeOff" GroupName="GrpCrosshairMode" Classes="segmented" Content="关闭" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadCrosshairModeHoldAlt" GroupName="GrpCrosshairMode" Classes="segmented" Content="开启" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadCrosshairModeAlways" GroupName="GrpCrosshairMode" Classes="segmented" Content="始终显示" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="softDivider" />

                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="左下角提示" Classes="fieldLabel" />
                                                    <TextBlock Text="开启后，在截图遮罩左下角显示当前操作与快捷键提示小抄。" Classes="fieldHint" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadShowCaptureHintsOff" GroupName="GrpShowCaptureHints" Classes="segmented" Content="关闭" />
                                                        <RadioButton x:Name="RadShowCaptureHintsOn" GroupName="GrpShowCaptureHints" Classes="segmented" Content="开启" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                        </StackPanel>
                                    </controls:ContinuousBorder>

                                    <controls:ContinuousBorder Classes="card">
                                        <StackPanel Spacing="10">
                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="长截图实时预览窗" Classes="fieldLabel" />
                                                    <TextBlock Text="开启后，在长截图过程中显示拼接缩略图与视口导航窗口。" Classes="fieldHint" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadShowLongScrollPreviewOff" GroupName="GrpShowLongScrollPreview" Classes="segmented" Content="关闭" />
                                                        <RadioButton x:Name="RadShowLongScrollPreviewOn" GroupName="GrpShowLongScrollPreview" Classes="segmented" Content="开启" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                </StackPanel>

                                <!-- 视图 2：贴图栏 -->
                                <StackPanel x:Name="PnlInteractSticker" Spacing="24" IsVisible="False">
                                    <controls:ContinuousBorder Classes="card">
                                        <StackPanel Spacing="10">
                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="贴图双击动作" Classes="fieldLabel" />
                                                    <TextBlock Text="双击贴图时的默认行为。" Classes="fieldHint" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadStickerDblClickClose" GroupName="GrpStickerDblClick" Classes="segmented" Content="关闭贴图" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadStickerDblClickThumbnail" GroupName="GrpStickerDblClick" Classes="segmented" Content="折叠为缩略图" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadStickerDblClickCopy" GroupName="GrpStickerDblClick" Classes="segmented" Content="复制图像" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadStickerDblClickNone" GroupName="GrpStickerDblClick" Classes="segmented" Content="无操作" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="softDivider" />

                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="贴图阴影" Classes="fieldLabel" />
                                                    <TextBlock Text="贴图窗口外围的阴影光晕。「自动」＝跟随截图时「阴影」勾选状态反向：截图未开阴影的贴图自动补窗体阴影以凸显边界，已开启烘焙阴影的贴图不叠加窗体阴影。任意贴图随时可按 Shift+Y 单独切换。" Classes="fieldHint" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadStickerDefaultShadowOff" GroupName="GrpStickerDefaultShadow" Classes="segmented" Content="关闭" ToolTip.Tip="所有贴图都不画窗体阴影" />
                                                        <RadioButton x:Name="RadStickerShadowAuto" GroupName="GrpStickerDefaultShadow" Classes="segmented" Content="自动" ToolTip.Tip="截图未开阴影时画窗体阴影、截图开阴影时不画；来源不明的贴图（剪贴板、历史、外部复制）一律画" />
                                                        <RadioButton x:Name="RadStickerDefaultShadowOn" GroupName="GrpStickerDefaultShadow" Classes="segmented" Content="开启" ToolTip.Tip="所有贴图都画窗体阴影" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="softDivider" />

                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="透明图片背景" Classes="fieldLabel" />
                                                    <TextBlock Text="透明图片贴图时垫透明格子，或直接透出桌面；窗口阴影照常保留。" Classes="fieldHint" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadStickerCheckerboardOn" GroupName="GrpStickerCheckerboard" Classes="segmented" Content="格子" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadStickerCheckerboardOff" GroupName="GrpStickerCheckerboard" Classes="segmented" Content="纯透明" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="softDivider" />

                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="贴图内文本可选择" Classes="fieldLabel" />
                                                    <TextBlock Text="开启后，允许在贴图上直接拖拽选中并复制文字。" Classes="fieldHint" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadStickerTextSelectableOff" GroupName="GrpStickerTextSelectable" Classes="segmented" Content="关闭" />
                                                        <RadioButton x:Name="RadStickerTextSelectableOn" GroupName="GrpStickerTextSelectable" Classes="segmented" Content="开启" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="softDivider" />

                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="划词工具栏" Classes="fieldLabel" />
                                                    <TextBlock Text="选中贴图上的文字后浮出工具条：复制、荧光/虚线/波浪线、翻译、AI。" Classes="fieldHint" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadStickerSelectionToolbarOff" GroupName="GrpStickerSelectionToolbar" Classes="segmented" Content="关闭" />
                                                        <RadioButton x:Name="RadStickerSelectionToolbarOn" GroupName="GrpStickerSelectionToolbar" Classes="segmented" Content="开启" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="softDivider" />

                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="选中文本贴图" Classes="fieldLabel" />
                                                    <TextBlock Text="在别的软件里选中文字后直接按贴图热键钉上屏幕，无需先复制；原剪贴板内容自动还原。" Classes="fieldHint" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadStickerGrabSelectedTextOff" GroupName="GrpStickerGrabSelectedText" Classes="segmented" Content="关闭" />
                                                        <RadioButton x:Name="RadStickerGrabSelectedTextOn" GroupName="GrpStickerGrabSelectedText" Classes="segmented" Content="开启" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="softDivider" />

                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="调整文本贴图" Classes="fieldLabel" />
                                                    <TextBlock Text="拖动文字贴图的左右边缘＝改每行字数（字号不变）；关闭时与滚轮一样只整体缩放。" Classes="fieldHint" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadStickerResizeReflowsTextOff" GroupName="GrpStickerResizeReflowsText" Classes="segmented" Content="关闭" />
                                                        <RadioButton x:Name="RadStickerResizeReflowsTextOn" GroupName="GrpStickerResizeReflowsText" Classes="segmented" Content="开启" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="softDivider" />

                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="恢复贴图的时间顺序" Classes="fieldLabel" />
                                                    <TextBlock Text="全局动作「恢复上次关闭的贴图」按哪个时间取最近一张；连按可依次恢复上一张。" Classes="fieldHint" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadStickerRestoreByClosed" GroupName="GrpStickerRestoreSort" Classes="segmented" Content="按关闭时间" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadStickerRestoreByCreated" GroupName="GrpStickerRestoreSort" Classes="segmented" Content="按创建时间" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="softDivider" />

                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="贴图取色器" Classes="fieldLabel" />
                                                    <TextBlock Text="图片贴图上按住取色修饰键悬停，指针旁出放大镜与色值（默认 Shift）。唤出键、复制色值与切换格式可在「快捷键 → 贴图」里修改。" Classes="fieldHint" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadStickerColorPickerOff" GroupName="GrpStickerColorPicker" Classes="segmented" Content="关闭" />
                                                        <RadioButton x:Name="RadStickerColorPickerOn" GroupName="GrpStickerColorPicker" Classes="segmented" Content="开启" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                </StackPanel>

                                <!-- 视图 3：录屏栏（2026-09-24 瘦身：参数条／预览窗已有入口的那六行从此不再在此重复设控件，
                                     设置页只留"别处没有"的项。判据与截图圆角/阴影/描边同一条。 -->
                                <StackPanel x:Name="PnlInteractRecord" Spacing="24" IsVisible="False">
                                    <controls:ContinuousBorder Classes="card">
                                        <StackPanel Spacing="10">
                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="光标入画" Classes="fieldLabel" />
                                                    <TextBlock Text="鼠标是否进画面。关闭后成品里没有鼠标，点击涟漪也看不见。" Classes="fieldHint" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadRecCursorOff" GroupName="GrpRecCursor" Classes="segmented" Content="关闭" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadRecCursorOn" GroupName="GrpRecCursor" Classes="segmented" Content="开启" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="softDivider" />

                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="画面采集方式" Classes="fieldLabel" />
                                                    <TextBlock Text="用于 FFmpeg：推荐 DXGI，兼容 GDI。Windows 原生使用 GDI。" Classes="fieldHint" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadRecCapAuto" GroupName="GrpRecCapture" Classes="segmented" Content="推荐" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadRecCapGdi" GroupName="GrpRecCapture" Classes="segmented" Content="兼容" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="softDivider" />
                                            <Grid x:Name="RecEngineRow" Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="录制引擎" Classes="fieldLabel" />
                                                    <TextBlock Text="自动优先 Windows。FFmpeg 来源可在「依赖运行」中设置。" Classes="fieldHint" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadRecEngineAuto" GroupName="GrpRecEngine" Classes="segmented" Content="自动" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadRecEngineWindows" GroupName="GrpRecEngine" Classes="segmented" Content="Windows" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadRecEngineFfmpeg" GroupName="GrpRecEngine" Classes="segmented" Content="FFmpeg" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                        </StackPanel>
                                    </controls:ContinuousBorder>

                                    <!-- 画质预设（2026-09-29 第五版）：内置四档可改参数、可隐藏、可还原；可新建自定义档（最多 8 个）。
                                         形态＝<b>行只读 ＋ 双击开编辑窗</b>（照「AI 模型」那套卡片＋独立编辑窗）。
                                         一行一档，四个量摊在行上（帧率／分辨率上限／码率／体积），改参数在弹出的
                                         <c>RecordPresetEditWindow</c> 里，行本身不吃单击。
                                         🔴 被否掉的前四版：点行就地展开 → 主从双栏 → 双栏精修 → 卡片流＋就地展开，
                                         病根都在"编辑态长在列表里"——重铺一次焦点就丢一次，且行既要当读数又要当表单。
                                         ⚠ 界面上不写长解释（用户 2026-09-29：「标注文字写得太多了，不要写那么细，默认用户懂」），
                                         必要范围值只进编辑窗的说明行与 ToolTip。
                                         列宽与字号：档名列 124（8 字实测 121）＋四个数字块定宽 ⇒ 六档同列上下可比。
                                         「显示」＝是否出现在录制参数条的画质下拉里；合法范围见 Core/Recording/RecordPresets.cs。 -->
                                    <controls:ContinuousBorder Classes="card">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="画质预设" Classes="fieldLabel" />
                                                    <TextBlock Text="勾选「显示」的档出现在录制参数条的下拉里。双击一行打开编辑窗。" Classes="fieldHint" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button x:Name="BtnRecPresetAdd" Grid.Column="1" Classes="secondary" Content="新建预设" MinWidth="88"
                                                        VerticalAlignment="Center" Click="OnRecPresetAddClick" />
                                            </Grid>
                                            <StackPanel x:Name="RecPresetListPanel" Spacing="4" />
                                        </StackPanel>
                                    </controls:ContinuousBorder>

                                    <!-- 声音：「双开时混音」两档 2026-09-26 撤控件（截图软件的录屏不做后期，恒自动混音），
                                         `RecAudioMix` 键与参数条那条读取链原样留着 -->
                                    <controls:ContinuousBorder Classes="card">
                                        <StackPanel Spacing="10">
                                            <!-- 麦克风音量：与同栏「画面采集方式」同一档 fieldRow 版式（左＝名称＋说明，右＝控件），
                                                 右侧控件严格对齐「截图」栏滑块细节：40格、320px宽（每列8px、齿宽4px、间距4px）＋底部 40/70/100 刻度。 -->
                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="麦克风音量" Classes="fieldLabel" />
                                                    <TextBlock Text="混音时麦克风占比。" Classes="fieldHint" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <StackPanel Width="320" Spacing="3" VerticalAlignment="Center">
                                                        <controls:NotchedSlider x:Name="NsdRecMicVol" ShowInput="False"
                                                                                Width="320"
                                                                                Minimum="40" Maximum="100" CellCount="40" />
                                                        <Grid ColumnDefinitions="*,*,*">
                                                            <TextBlock Text="40" FontSize="10" Opacity="0.7"
                                                                       Foreground="{DynamicResource SctTextMutedBrush}" />
                                                            <TextBlock Grid.Column="1" Text="70" FontSize="10" Opacity="0.7"
                                                                       HorizontalAlignment="Center"
                                                                       Foreground="{DynamicResource SctTextMutedBrush}" />
                                                            <TextBlock Grid.Column="2" Text="100" FontSize="10" Opacity="0.7"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="{DynamicResource SctTextMutedBrush}" />
                                                        </Grid>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                        <TextBox x:Name="TxtRecMicVol" Classes="bigVal" Text="40" MinWidth="40"
                                                                 TextInput="OnTxtRecMicVolTextInput"
                                                                 KeyDown="OnTxtRecMicVolKeyDown" LostFocus="OnTxtRecMicVolLostFocus" />
                                                        <TextBlock Text="%" FontSize="11" Margin="0,0,0,2"
                                                                   Foreground="{DynamicResource SctTextMutedBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                </StackPanel>

                                <!-- 视图 4：抠图栏 -->
                                <StackPanel x:Name="PnlInteractMatting" Spacing="24" IsVisible="False">
                                    <controls:ContinuousBorder Classes="card">
                                        <StackPanel Spacing="10">
                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="智能抠图默认模型" Classes="fieldLabel" />
                                                    <TextBlock Text="截图工具栏与快捷键（Shift+K）默认用的模型。" Classes="fieldHint" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadMattingModelGeneral" GroupName="GrpMattingModel" Classes="segmented" Content="通用 (U²-NetP)" ToolTip.Tip="适合任意通用主体、静物、宠物、商品与图标，轻量迅速" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadMattingModelPortrait" GroupName="GrpMattingModel" Classes="segmented" Content="人像 (MODNet)" ToolTip.Tip="专为人物肖像、自拍设计，支持发丝级精细 Alpha 抠图" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="softDivider" />

                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="抠图结果" Classes="fieldLabel" />
                                                    <TextBlock Text="抠图完成后结果的去向，对所有抠图入口生效。" Classes="fieldHint" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadMattingResultClipboard" GroupName="GrpMattingResult" Classes="segmented" Content="剪贴板" ToolTip.Tip="结果仅写入剪贴板：贴图右键抠图不改动原贴图；截图工具栏/脚本发起的抠图完成后临时贴图自动关闭" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadMattingResultSticker" GroupName="GrpMattingResult" Classes="segmented" Content="贴图" ToolTip.Tip="结果仅生成贴图展示（透明棋盘格承托），不写入剪贴板" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadMattingResultBoth" GroupName="GrpMattingResult" Classes="segmented" Content="剪贴板并贴图" ToolTip.Tip="结果写入剪贴板并生成贴图（默认，即历史行为）" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                </StackPanel>
                            </StackPanel>


                            <!-- ============ 标注（截图与贴图两侧共用的标注行为） ============ -->
                            <StackPanel x:Name="PanelAnnot" Spacing="24" IsVisible="False">
                                <StackPanel Spacing="8" Margin="0,0,0,4">
                                    <TextBlock Text="标注" Classes="pageTitle" />
                                    <TextBlock Text="截图与贴图共用的标注行为。" Classes="pageDescription" />
                                </StackPanel>

                                <controls:ContinuousBorder Classes="card">
                                    <StackPanel Spacing="10">
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="沿用上次标注工具" Classes="fieldLabel" />
                                                <TextBlock Text="建立选区时自动选用上次用过的标注工具。" Classes="fieldHint" />
                                            </StackPanel>
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadReuseLastAnnotationToolOff" GroupName="GrpReuseLastAnnotationTool" Classes="segmented" Content="关闭" />
                                                    <RadioButton x:Name="RadReuseLastAnnotationToolOn" GroupName="GrpReuseLastAnnotationTool" Classes="segmented" Content="开启" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>
                                        <controls:ContinuousBorder Classes="softDivider" />

                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="删除序号时自动重编号" Classes="fieldLabel" />
                                                <TextBlock Text="删掉某个序号时，后面的编号依次前移保持连续；关闭则保留原编号、留下跳号。" Classes="fieldHint" />
                                            </StackPanel>
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadCounterRenumberOff" GroupName="GrpCounterRenumber" Classes="segmented" Content="关闭" />
                                                    <RadioButton x:Name="RadCounterRenumberOn" GroupName="GrpCounterRenumber" Classes="segmented" Content="开启" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>
                                        <controls:ContinuousBorder Classes="softDivider" />

                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="记住上次序号样式" Classes="fieldLabel" />
                                                <TextBlock Text="序号的类型、外形、底色、胶囊圆角与引线箭头沿用上次；关闭则每次回到默认。大小一项始终记忆。" Classes="fieldHint" />
                                            </StackPanel>
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadCounterRememberOff" GroupName="GrpCounterRemember" Classes="segmented" Content="关闭" />
                                                    <RadioButton x:Name="RadCounterRememberOn" GroupName="GrpCounterRemember" Classes="segmented" Content="开启" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>
                                    </StackPanel>
                                </controls:ContinuousBorder>
                            </StackPanel>


                            <!-- ============ 快捷键与动作 ============ -->
                            <StackPanel x:Name="PanelActions" Spacing="16" IsVisible="False">
                                <TextBlock Text="快捷键与动作" Classes="pageTitle" Margin="0,0,0,2" />

                                <!-- 顶部控制栏：五段式页签切换 + 辅助按钮 -->
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- 五段式分段切换：截图 / 贴图 / 录屏 / 全局动作 / 外部调用指引
                                         （"录屏"是 2026-09-29 补的一档：录制会话键此前散在三套机制里，
                                          设置页连一栏都没有，只在全局动作视图下挂一张只读卡） -->
                                    <controls:ContinuousBorder Grid.Column="0" Classes="segmentedGroup">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RadActionTabCapture" GroupName="GrpActionTabs" Classes="segmented" Content="截图" IsChecked="True" IsCheckedChanged="OnActionTabSelectionChanged" />
                                            <Rectangle Classes="segmentedDivider" />
                                            <RadioButton x:Name="RadActionTabSticker" GroupName="GrpActionTabs" Classes="segmented" Content="贴图" IsCheckedChanged="OnActionTabSelectionChanged" />
                                            <Rectangle Classes="segmentedDivider" />
                                            <RadioButton x:Name="RadActionTabRecord" GroupName="GrpActionTabs" Classes="segmented" Content="录屏" IsCheckedChanged="OnActionTabSelectionChanged" />
                                            <Rectangle Classes="segmentedDivider" />
                                            <RadioButton x:Name="RadActionTabGlobal" GroupName="GrpActionTabs" Classes="segmented" Content="全局动作" IsCheckedChanged="OnActionTabSelectionChanged" />
                                            <Rectangle Classes="segmentedDivider" />
                                            <RadioButton x:Name="RadActionTabGuide" GroupName="GrpActionTabs" Classes="segmented" Content="外部调用指引" IsCheckedChanged="OnActionTabSelectionChanged" />
                                        </StackPanel>
                                    </controls:ContinuousBorder>

                                    <!-- 右侧按钮组 -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button x:Name="BtnResetAllDefaults" Content="恢复默认" MinWidth="80" Click="OnResetAllShortcutDefaultsClick" ToolTip.Tip="恢复默认快捷键设置" />
                                        <Button x:Name="BtnAddAction" Content="＋ 新增动作" Classes="primary" MinWidth="96" Click="OnAddActionClick" IsVisible="False" />
                                    </StackPanel>
                                </Grid>

                                <!-- 视图 1：截图会话快捷键 -->
                                <StackPanel x:Name="PnlViewCapture" Spacing="10">
                                    <controls:ContinuousBorder Classes="card">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="截图会话期间的窗口级快捷键，仅在截图窗口前台时生效。点击右侧键帽重新录制。" Classes="cardDesc" />
                                            <StackPanel x:Name="CaptureShortcutGroupPanel" Spacing="6" />
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                    <TextBlock Text="提示：按住空格键拖动鼠标可平移选区；鼠标中键可将选区直接转为贴图。" Classes="hintRow" />
                                    <TextBlock x:Name="TxtCaptureHotKeyTip" Text="" Classes="fieldHint" Margin="4,0,0,0" Foreground="{DynamicResource SctAccentBrush}" />
                                </StackPanel>

                                <!-- 视图 2：贴图窗口快捷键 -->
                                <StackPanel x:Name="PnlViewSticker" Spacing="10" IsVisible="False">
                                    <controls:ContinuousBorder Classes="card">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="点击右侧键帽修改。取色唤出键与精细缩放修饰键可改，精细缩放固定配合滚轮。" Classes="cardDesc" />
                                            <StackPanel x:Name="StickerShortcutGroupPanel" Spacing="6" />
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                    <TextBlock Text="以下手势固定、不参与自定义：方向键移动选中标注、+ / - 改序号、Ctrl+滚轮不透明度、滚轮缩放、Shift+双击进缩略图、Alt+拖选文字、Ctrl+拖拽导出。" Classes="hintRow" />
                                    <TextBlock x:Name="TxtStickerHotKeyTip" Text="" Classes="fieldHint" Margin="4,0,0,0" Foreground="{DynamicResource SctAccentBrush}" />
                                </StackPanel>

                                <!-- 视图 3：录屏会话快捷键 -->
                                <StackPanel x:Name="PnlViewRecord" Spacing="10" IsVisible="False">
                                    <controls:ContinuousBorder Classes="card">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="快速启停在选中录屏工具后生效，留空沿用区域截图快捷键；右键键帽可清空。其他控制键在录制期间生效，结束即释放。全局「开始录制」快捷键在「全局动作」中修改。" Classes="cardDesc" />
                                            <StackPanel x:Name="RecordShortcutGroupPanel" Spacing="6" />
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                    <TextBlock Text="提示：「完成录制（兜底键）」与「取消录制 / 倒计时」固定不可改——它们走键盘钩子而非热键注册，是热键被其他软件占用时的退路。" Classes="hintRow" />
                                    <TextBlock x:Name="TxtRecordHotKeyTip" Text="" Classes="fieldHint" Margin="4,0,0,0" Foreground="{DynamicResource SctAccentBrush}" />
                                </StackPanel>

                                <!-- 视图 4：全局动作快捷键 -->
                                <StackPanel x:Name="PnlViewGlobalActions" Spacing="10" IsVisible="False">
                                    <controls:ContinuousBorder Classes="card">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="每个动作可同时绑定键盘快捷键与全局鼠标，也可清空后通过 CLI 调用。鼠标需含辅助键；支持选区的动作可直接拖动框选。" Classes="cardDesc" TextWrapping="Wrap" />
                                            <StackPanel x:Name="ActionListPanel" Spacing="6" />
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                </StackPanel>

                                <!-- 视图 5：外部调用指引 -->
                                <StackPanel x:Name="PnlViewGuide" Spacing="14" IsVisible="False">
                                    <controls:ContinuousBorder Classes="card">
                                        <StackPanel Spacing="14">
                                            <controls:ContinuousBorder Classes="guideBox">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="# 1. 按名称调用已保存的动作：" Foreground="{DynamicResource SctTextMutedBrush}" FontFamily="Consolas, monospace" FontSize="12" />
                                                    <TextBlock Text="yuSnip.exe -a &quot;截图并OCR（弹窗）&quot;" Foreground="{DynamicResource SctAccentBrush}" FontFamily="Consolas, monospace" FontSize="13" />
                                                    <controls:ContinuousBorder Classes="softDivider" Margin="0,4" />
                                                    <TextBlock Text="# 2. 直接执行单行 JavaScript 脚本指令：" Foreground="{DynamicResource SctTextMutedBrush}" FontFamily="Consolas, monospace" FontSize="12" />
                                                    <TextBlock Text="yuSnip.exe -r &quot;yuSnip.translate('Silent');&quot;" Foreground="{DynamicResource SctAccentBrush}" FontFamily="Consolas, monospace" FontSize="13" />
                                                    <controls:ContinuousBorder Classes="softDivider" Margin="0,4" />
                                                    <TextBlock Text="# 3. 从外部 .js 脚本文件执行：" Foreground="{DynamicResource SctTextMutedBrush}" FontFamily="Consolas, monospace" FontSize="12" />
                                                    <TextBlock Text="yuSnip.exe -f &quot;C:\Scripts\my_custom_action.js&quot;" Foreground="{DynamicResource SctAccentBrush}" FontFamily="Consolas, monospace" FontSize="13" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                </StackPanel>
                            </StackPanel>


                            <!-- ============ OCR与翻译 ============ -->
                            <StackPanel x:Name="PanelTranslate" Spacing="24" IsVisible="False">
                                <StackPanel Spacing="8" Margin="0,0,0,4">
                                    <TextBlock Text="OCR与翻译" Classes="pageTitle" />
                                        <TextBlock Text="配置文字识别结果与翻译服务（bilibili-index / 百度翻译 / 有道智云）。" Classes="pageDescription" />
                                </StackPanel>

                                <!-- OCR 设置 -->
                                <controls:ContinuousBorder Classes="card">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="OCR 结果处理" Classes="fieldLabel" VerticalAlignment="Center" />
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadOcrOutputWindow" GroupName="GrpOcrOutput" Classes="segmented" Content="打开编辑窗口" />
                                                    <RadioButton x:Name="RadOcrOutputClipboard" GroupName="GrpOcrOutput" Classes="segmented" Content="静默复制" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>
                                        <TextBlock Text="识别完怎么处理。静默复制＝不开窗口，结果直接进剪贴板并短暂提示。" Classes="fieldHint" TextWrapping="Wrap" />

                                        <controls:ContinuousBorder Classes="softDivider" />

                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="提示窗位置" Classes="fieldLabel" />
                                                <TextBlock Text="静默复制成功时在屏幕上弹出的提示卡片位置。" Classes="fieldHint" />
                                            </StackPanel>
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadOcrToastPosTopCenter" GroupName="GrpOcrToastPos" Classes="segmented" Content="中上" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadOcrToastPosBottomCenter" GroupName="GrpOcrToastPos" Classes="segmented" Content="中下" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadOcrToastPosTopRight" GroupName="GrpOcrToastPos" Classes="segmented" Content="右上" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadOcrToastPosBottomRight" GroupName="GrpOcrToastPos" Classes="segmented" Content="右下" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadOcrToastPosNone" GroupName="GrpOcrToastPos" Classes="segmented" Content="无" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>

                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="提示窗等待时间" Classes="fieldLabel" />
                                                <TextBlock Text="提示卡片自动消失前的停留时长，鼠标悬停期间暂停计时。" Classes="fieldHint" />
                                            </StackPanel>
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadOcrToastSec3" GroupName="GrpOcrToastSec" Classes="segmented" Content="3秒" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadOcrToastSec5" GroupName="GrpOcrToastSec" Classes="segmented" Content="5秒" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadOcrToastSec10" GroupName="GrpOcrToastSec" Classes="segmented" Content="10秒" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>
                                    </StackPanel>
                                </controls:ContinuousBorder>

                                <controls:ContinuousBorder Classes="card">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="翻译服务商" Classes="fieldLabel" VerticalAlignment="Center" />
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadTranslateNone" GroupName="GrpTranslateProvider" Classes="segmented" Content="不启用" IsCheckedChanged="OnTranslateProviderChanged" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadTranslateIndex" GroupName="GrpTranslateProvider" Classes="segmented" Content="bilibili-index" IsCheckedChanged="OnTranslateProviderChanged" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadTranslateBaidu" GroupName="GrpTranslateProvider" Classes="segmented" Content="百度翻译" IsCheckedChanged="OnTranslateProviderChanged" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadTranslateYoudao" GroupName="GrpTranslateProvider" Classes="segmented" Content="有道智云" IsCheckedChanged="OnTranslateProviderChanged" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>
                                        <TextBlock Text="bilibili-index 免费使用，无需密钥；百度翻译或有道智云需配置各自的 API 密钥。" Classes="fieldHint" />
                                    </StackPanel>
                                </controls:ContinuousBorder>

<controls:ContinuousBorder Classes="card" x:Name="BaiduKeyCard">
<StackPanel Spacing="12">
<StackPanel Spacing="6">
<TextBlock Text="APP ID (百度翻译)" Classes="secondary" />
<TextBox x:Name="TxtBaiduAppId" Watermark="输入百度翻译 APP ID (来自开发者信息)" />
</StackPanel>
<StackPanel Spacing="6">
<TextBlock Text="API Key (百度翻译)" Classes="secondary" />
<Grid>
<TextBox x:Name="TxtBaiduSecretKey" Watermark="输入百度翻译 API Key (来自 API Key 管理)" PasswordChar="*" Padding="10,6,36,6" />
<Button Classes="eyeToggle" HorizontalAlignment="Right" Margin="0,0,4,0" Click="OnTogglePasswordVisibility">
<Panel>
<Path Classes="eyeIcon" Data="M12,4.5C7,4.5 2.73,7.61 1,12c1.73,4.39 6,7.5 11,7.5s9.27,-3.11 11,-7.5c-1.73,-4.39 -6,-7.5 -11,-7.5zM12,17c-2.76,0 -5,-2.24 -5,-5s2.24,-5 5,-5 5,2.24 5,5 -2.24,5 -5,5zM12,9c-1.66,0 -3,1.34 -3,3s1.34,3 3,3 3,-1.34 3,-3 -1.34,-3 -3,-3z" />
<Path Classes="eyeOffIcon" Data="M12,7c2.76,0 5,2.24 5,5 0,0.65 -0.13,1.26 -0.36,1.83l2.92,2.92c1.51,-1.26 2.7,-2.89 3.43,-4.75 -1.73,-4.39 -6,-7.5 -11,-7.5 -1.4,0 -2.74,0.25 -3.98,0.7l2.16,2.16C10.74,7.13 11.35,7 12,7zM2,4.27l2.28,2.28 0.46,0.46C3.08,8.3 1.78,10.02 1,12c1.73,4.39 6,7.5 11,7.5 1.55,0 3.03,-0.3 4.38,-0.84l0.42,0.42L19.73,22 21,20.73 3.27,3 2,4.27zM7.53,9.8l1.55,1.55c-0.05,0.21 -0.08,0.43 -0.08,0.65 0,1.66 1.34,3 3,3 0.22,0 0.44,-0.03 0.65,-0.08l1.55,1.55c-0.67,0.33 -1.41,0.53 -2.2,0.53 -2.76,0 -5,-2.24 -5,-5 0,-0.79 0.2,-1.53 0.53,-2.2z" IsVisible="False" />
</Panel>
</Button>
</Grid>
</StackPanel>
<Grid ColumnDefinitions="Auto,*,Auto">
    <Button Grid.Column="0" x:Name="BtnTranslateBaiduLink" Classes="apiKeyEntry" Click="OnBaiduLinkClick">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="apiKeyEntryIcon" Data="{x:Static win:OcrIconGeometry.OpenInNew}" />
            <TextBlock Text="获取 API Key (百度翻译开放平台)" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
    <StackPanel Grid.Column="1" x:Name="BaiduValidateStatus" Classes="translateStatus" Orientation="Horizontal" Spacing="6"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,14,0" IsVisible="False">
        <Path x:Name="BaiduValidateStatusOkIcon" Data="{x:Static win:OcrIconGeometry.CheckCircle}" />
        <Path x:Name="BaiduValidateStatusErrIcon" Data="{x:Static win:OcrIconGeometry.ErrorCircle}" IsVisible="False" />
        <TextBlock x:Name="BaiduValidateStatusText" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
    </StackPanel>
    <Button Grid.Column="2" x:Name="BtnTranslateBaiduValidate" Content="验证凭证" Click="OnTranslateValidateClick" Classes="primary" MinWidth="96" VerticalAlignment="Center" />
</Grid>
</StackPanel>
</controls:ContinuousBorder>

<controls:ContinuousBorder Classes="card" x:Name="YoudaoKeyCard">
<StackPanel Spacing="12">
<StackPanel Spacing="6">
<TextBlock Text="应用 ID (有道智云)" Classes="secondary" />
<TextBox x:Name="TxtYoudaoAppId" Watermark="输入有道智云应用 ID" />
</StackPanel>
<StackPanel Spacing="6">
<TextBlock Text="应用密钥 (有道智云)" Classes="secondary" />
<Grid>
<TextBox x:Name="TxtYoudaoSecretKey" Watermark="输入有道智云应用密钥" PasswordChar="*" Padding="10,6,36,6" />
<Button Classes="eyeToggle" HorizontalAlignment="Right" Margin="0,0,4,0" Click="OnTogglePasswordVisibility">
<Panel>
<Path Classes="eyeIcon" Data="M12,4.5C7,4.5 2.73,7.61 1,12c1.73,4.39 6,7.5 11,7.5s9.27,-3.11 11,-7.5c-1.73,-4.39 -6,-7.5 -11,-7.5zM12,17c-2.76,0 -5,-2.24 -5,-5s2.24,-5 5,-5 5,2.24 5,5 -2.24,5 -5,5zM12,9c-1.66,0 -3,1.34 -3,3s1.34,3 3,3 3,-1.34 3,-3 -1.34,-3 -3,-3z" />
<Path Classes="eyeOffIcon" Data="M12,7c2.76,0 5,2.24 5,5 0,0.65 -0.13,1.26 -0.36,1.83l2.92,2.92c1.51,-1.26 2.7,-2.89 3.43,-4.75 -1.73,-4.39 -6,-7.5 -11,-7.5 -1.4,0 -2.74,0.25 -3.98,0.7l2.16,2.16C10.74,7.13 11.35,7 12,7zM2,4.27l2.28,2.28 0.46,0.46C3.08,8.3 1.78,10.02 1,12c1.73,4.39 6,7.5 11,7.5 1.55,0 3.03,-0.3 4.38,-0.84l0.42,0.42L19.73,22 21,20.73 3.27,3 2,4.27zM7.53,9.8l1.55,1.55c-0.05,0.21 -0.08,0.43 -0.08,0.65 0,1.66 1.34,3 3,3 0.22,0 0.44,-0.03 0.65,-0.08l1.55,1.55c-0.67,0.33 -1.41,0.53 -2.2,0.53 -2.76,0 -5,-2.24 -5,-5 0,-0.79 0.2,-1.53 0.53,-2.2z" IsVisible="False" />
</Panel>
</Button>
</Grid>
</StackPanel>
<Grid ColumnDefinitions="Auto,*,Auto">
    <Button Grid.Column="0" x:Name="BtnTranslateYoudaoLink" Classes="apiKeyEntry" Click="OnYoudaoLinkClick">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="apiKeyEntryIcon" Data="{x:Static win:OcrIconGeometry.OpenInNew}" />
            <TextBlock Text="获取 API 密钥 (有道智云)" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
    <StackPanel Grid.Column="1" x:Name="YoudaoValidateStatus" Classes="translateStatus" Orientation="Horizontal" Spacing="6"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,14,0" IsVisible="False">
        <Path x:Name="YoudaoValidateStatusOkIcon" Data="{x:Static win:OcrIconGeometry.CheckCircle}" />
        <Path x:Name="YoudaoValidateStatusErrIcon" Data="{x:Static win:OcrIconGeometry.ErrorCircle}" IsVisible="False" />
        <TextBlock x:Name="YoudaoValidateStatusText" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
    </StackPanel>
    <Button Grid.Column="2" x:Name="BtnTranslateYoudaoValidate" Content="验证密钥" Click="OnTranslateValidateClick" Classes="primary" MinWidth="96" VerticalAlignment="Center" />
</Grid>
</StackPanel>
</controls:ContinuousBorder>

                                <controls:ContinuousBorder Classes="card" x:Name="TranslateOptionsCard" IsVisible="False">
                                    <StackPanel Spacing="12">
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="源语言" Classes="fieldLabel" />
                                                <TextBlock Text="默认自动检测，可手动指定源语言以提高精度。" Classes="fieldHint" />
                                            </StackPanel>
                                            <ComboBox x:Name="CmbTranslateSourceLang" Grid.Column="1" MinWidth="140" />
                                        </Grid>
                                        <controls:ContinuousBorder Classes="softDivider" />
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="目标语言" Classes="fieldLabel" />
                                                <TextBlock Text="翻译结果默认显示的语言。" Classes="fieldHint" />
                                            </StackPanel>
                                            <ComboBox x:Name="CmbTranslateTargetLang" Grid.Column="1" MinWidth="140" />
                                        </Grid>
                                        <controls:ContinuousBorder Classes="softDivider" />
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="次级目标语言" Classes="fieldLabel" />
                                                <TextBlock Text="当源语言与目标语言相同时（如中文译中文），自动切换至该语言（默认英语）。" Classes="fieldHint" />
                                            </StackPanel>
                                            <ComboBox x:Name="CmbTranslateSecondaryTargetLang" Grid.Column="1" MinWidth="140" />
                                        </Grid>
                                        <controls:ContinuousBorder Classes="softDivider" />
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="翻译模式" Classes="fieldLabel" />
                                                <TextBlock x:Name="TxtTranslateModeHint" Text="图片到文本：OCR 识别后翻译为纯文本；图片到图片：将译文覆盖回原图对应位置。" Classes="fieldHint" />
                                            </StackPanel>
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadTranslateImageToText" GroupName="GrpTranslateMode" Classes="segmented" Content="图片到文本" />
                                                    <RadioButton x:Name="RadTranslateImageToImage" GroupName="GrpTranslateMode" Classes="segmented" Content="图片到图片" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>
                                        <controls:ContinuousBorder Classes="softDivider" />
                                        <!-- 只有「图片到文本」才有的选项：整体显隐，包含内部的分隔线 -->
                                        <StackPanel x:Name="PnlTranslateTextOnly" Spacing="12" IsVisible="False">
                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="流式翻译" Classes="fieldLabel" />
                                                    <TextBlock Text="整段一次送译，返回后本地整理双语；支持的服务边收边显示" Classes="fieldHint" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadTranslateStreamOff" GroupName="GrpTranslateStream" Classes="segmented" Content="关闭" />
                                                        <RadioButton x:Name="RadTranslateStreamOn" GroupName="GrpTranslateStream" Classes="segmented" Content="开启" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="softDivider" />
                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="极简浮窗位置" Classes="fieldLabel" />
                                                    <TextBlock Text="译文浮窗弹出在鼠标旁、屏幕正中还是中下位置" Classes="fieldHint" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadTranslateMiniPosFollow" GroupName="GrpTranslateMiniPos" Classes="segmented" Content="跟随鼠标" ToolTip.Tip="在鼠标光标右下角弹出，越界时自动翻到光标左侧或上方" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadTranslateMiniPosCenter" GroupName="GrpTranslateMiniPos" Classes="segmented" Content="屏幕居中" ToolTip.Tip="在当前屏幕工作区正中央弹出" />
                                                        <Rectangle Classes="segmentedDivider" />
                                                        <RadioButton x:Name="RadTranslateMiniPosBottomCenter" GroupName="GrpTranslateMiniPos" Classes="segmented" Content="中下" ToolTip.Tip="在当前屏幕工作区水平居中、贴近底部弹出" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="softDivider" />
                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="失去焦点后自动关闭" Classes="fieldLabel" />
                                                    <TextBlock Text="关闭后译文便签常驻，直到按 Esc 或双击进入编辑窗" Classes="fieldHint" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadTranslateMiniAutoCloseOff" GroupName="GrpTranslateMiniAutoClose" Classes="segmented" Content="关闭" />
                                                        <RadioButton x:Name="RadTranslateMiniAutoCloseOn" GroupName="GrpTranslateMiniAutoClose" Classes="segmented" Content="开启" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="softDivider" />
                                            <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="翻译后写入剪贴板" Classes="fieldLabel" />
                                                    <TextBlock Text="全部翻译完成后自动复制，会覆盖剪贴板原有内容；关闭则需手动复制。"
                                                               Classes="fieldHint" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadTranslateMiniCopyOff" GroupName="GrpTranslateMiniCopy" Classes="segmented" Content="关闭" />
                                                        <RadioButton x:Name="RadTranslateMiniCopyOn" GroupName="GrpTranslateMiniCopy" Classes="segmented" Content="开启" />
                                                    </StackPanel>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </controls:ContinuousBorder>
                            </StackPanel>


                            <!-- ============ AI 模型 ============ -->
                            <StackPanel x:Name="PanelAi" Spacing="24" IsVisible="False">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,0,4">
                                        <TextBlock Text="AI 模型" Classes="pageTitle" />
                                        <TextBlock Text="配置多个大模型服务端点、API 密钥与模型列表，支持独立启停控制。" Classes="pageDescription" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="primary"
                                            Content="＋ 添加服务商"
                                            VerticalAlignment="Center"
                                            Padding="14,8"
                                            Click="OnAddAiProviderClick" />
                                </Grid>

                                <!-- 服务商列表容器 -->
                                <StackPanel x:Name="AiProvidersPanel" Spacing="8" />

                                <!-- 全局提示词与功能 -->
                                <controls:ContinuousBorder Classes="card">
                                    <StackPanel Spacing="16">
                                        <!-- 1. 识图触发方式 -->
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="识图触发方式" Classes="fieldLabel" />
                                                <TextBlock Text="点击 AI 识图后：一键用默认提示词分析，或每次弹窗输入需求。" Classes="fieldHint" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadAiUseDefaultPromptOn" GroupName="GrpAiUseDefaultPrompt" Classes="segmented" Content="直接识图" ToolTip.Tip="点击 AI 识图后立即执行，使用「预设提示词」卡片中标记默认的提示词" />
                                                    <RadioButton x:Name="RadAiUseDefaultPromptOff" GroupName="GrpAiUseDefaultPrompt" Classes="segmented" Content="每次提问" ToolTip.Tip="截图后弹出极简提问框，可临时输入问题或切换模型" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>

                                        <controls:ContinuousBorder Classes="softDivider" />

                                        <!-- 3. 提问弹窗位置 -->
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="提问弹窗位置" Classes="fieldLabel" />
                                                <TextBlock Text="设置“每次提问”模式下，极简输入弹窗在屏幕上的弹出位置。" Classes="fieldHint" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadAiPromptPosFollowMouse" GroupName="GrpAiPromptPos" Classes="segmented" Content="跟随鼠标" ToolTip.Tip="在鼠标光标附近弹出输入框（自动防屏幕边缘溢出）" />
                                                    <RadioButton x:Name="RadAiPromptPosCenterScreen" GroupName="GrpAiPromptPos" Classes="segmented" Content="屏幕居中" ToolTip.Tip="在当前活动屏幕中央弹出输入框" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>

                                        <controls:ContinuousBorder Classes="softDivider" />

                                        <!-- 4. 联网搜索增强 -->
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="联网搜索增强" Classes="fieldLabel" />
                                                <TextBlock Text="识图完成后自动联网检索相关网页，展示参考来源并基于网页事实生成深度分析。" Classes="fieldHint" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadAiSearchOff" GroupName="GrpAiSearch" Classes="segmented" Content="关闭" />
                                                    <RadioButton x:Name="RadAiSearchOn" GroupName="GrpAiSearch" Classes="segmented" Content="开启" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>

                                        <controls:ContinuousBorder Classes="softDivider" />

                                        <!-- 5. 深度思考 -->
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="深度思考" Classes="fieldLabel" />
                                                <TextBlock Text="推理模型每次作答前先思考，答案更稳但更慢。关闭后请求上游直接快答，适合日常高频问答；对话窗口里也能随时切换。" Classes="fieldHint" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadAiThinkingOff" GroupName="GrpAiThinking" Classes="segmented" Content="关闭" ToolTip.Tip="请求上游跳过思考直接作答（不认该参数的服务商会自动回退为正常请求）" />
                                                    <RadioButton x:Name="RadAiThinkingOn" GroupName="GrpAiThinking" Classes="segmented" Content="开启" ToolTip.Tip="保持模型自身的思考行为（历来默认）" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>
                                    </StackPanel>
                                </controls:ContinuousBorder>

                                <!-- 预设提示词（多预设 + 技能命令 + @ 唤起）：与「AI 识图交互与提示词」平级的独立卡片 -->
                                <controls:ContinuousBorder Classes="card">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="预设提示词管理" Classes="fieldLabel" />
                                                <TextBlock Text="每条提示词对应一个技能命令，「直接识图」使用默认项；AI 提问框输入 @ 可快速选用。" Classes="fieldHint" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="primary"
                                                    Content="＋ 添加提示词"
                                                    VerticalAlignment="Center"
                                                    Padding="14,8"
                                                    ToolTip.Tip="新增一条预设提示词并设置技能命令名"
                                                    Click="OnAddAiPromptPresetClick" />
                                        </Grid>
                                        <StackPanel x:Name="AiPromptPresetsPanel" Spacing="6" />
                                    </StackPanel>
                                </controls:ContinuousBorder>
                            </StackPanel>


                            <!-- ============ 配置云存储 ============ -->
                            <StackPanel x:Name="PanelCloudSync" Spacing="24" IsVisible="False">
                                <StackPanel Spacing="8" Margin="0,0,0,4">
                                    <TextBlock Text="云存储配置" Classes="pageTitle" />
                                    <TextBlock Text="备份与恢复配置：Google Drive、WebDAV 云同步与本地文件。" Classes="pageDescription" />
                                </StackPanel>

                                <!-- 同步方式选择 -->
                                <controls:ContinuousBorder Classes="card">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="同步服务商" Classes="fieldLabel" VerticalAlignment="Center" />
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadCloudNone" GroupName="GrpCloudProvider" Classes="segmented" Content="不启用" IsCheckedChanged="OnCloudProviderChanged" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadCloudGDrive" GroupName="GrpCloudProvider" Classes="segmented" Content="Google Drive" IsCheckedChanged="OnCloudProviderChanged" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadCloudWebDav" GroupName="GrpCloudProvider" Classes="segmented" Content="WebDAV" IsCheckedChanged="OnCloudProviderChanged" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>
                                        <TextBlock Text="选 Google Drive 或 WebDAV 云同步，或不启用、只用本地配置。" Classes="fieldHint" />
                                        <controls:ContinuousBorder Classes="softDivider" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="密钥与凭据" Classes="fieldLabel" VerticalAlignment="Center" />
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadCloudSecretsOn" GroupName="GrpCloudSecrets" Classes="segmented" Content="同步" IsCheckedChanged="OnCloudSecretsChanged" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadCloudSecretsOff" GroupName="GrpCloudSecrets" Classes="segmented" Content="不同步" IsCheckedChanged="OnCloudSecretsChanged" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>
                                        <TextBlock Text="控制 AI 与翻译密钥是否共享。自动同步始终保留本机的云端连接凭据；快捷键与动作始终同步。" Classes="fieldHint" TextWrapping="Wrap" />
                                        <TextBlock x:Name="TxtCloudSecretsWarn"
                                                   Classes="fieldHint"
                                                   Foreground="{DynamicResource SctWarnBrush}"
                                                   TextWrapping="Wrap"
                                                   IsVisible="False"
                                                   Text="关闭后，新的自动修订不再携带密钥。旧修订和手动备份仍可能包含密钥，需要在云端自行清理历史文件。" />
                                    </StackPanel>
                                </controls:ContinuousBorder>

                                <!-- ===== Google Drive ===== -->
                                <!-- 账号独立一行；状态读数下方用紧凑工具栏承载同步开关与操作。 -->
                                <controls:ContinuousBorder Classes="card" x:Name="GDriveCard" IsVisible="False">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" MinHeight="20">
                                            <TextBlock Text="Google Drive 授权" Classes="fieldLabel" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Ellipse x:Name="GDriveStatusDot" Width="10" Height="10" Classes="statusDot" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtGDriveConnected" Text="未连接" Classes="fieldLabel" FontWeight="Medium" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                        <controls:ContinuousBorder Classes="softDivider" />
                                        <Grid Classes="fieldRow" ColumnDefinitions="Auto,*,Auto">
                                            <!-- 头像放大到 56 ＋ 2px 品牌紫描边：参照图那圈描边才是它"放大后好看"的主因，
                                                 单放大不带描边会塌成一块灰圆。占位底常驻不藏，藏了右簇整排会跟着左移。 -->
                                            <Ellipse Grid.Column="0" x:Name="GDriveAvatar" Width="56" Height="56" ClipToBounds="True"
                                                     Fill="{DynamicResource SctRowBgBrush}" Stroke="{DynamicResource SctAccentBrush}" StrokeThickness="2"
                                                     Margin="0,0,16,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,20,0">
                                                <TextBlock x:Name="TxtGDriveEmail" Text="未连接 Google 账号" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource SctTextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                <TextBlock x:Name="TxtGDriveStatus" Classes="fieldHint" TextWrapping="Wrap" Text="点右侧按钮，在浏览器里完成 Google 授权。" />
                                            </StackPanel>
                                            <!-- 账号行只处理登录与退出，同步操作放在底行。 -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <Button x:Name="BtnGDriveLogin" Content="登录 Google Drive" Classes="primary" Click="OnGDriveLoginClick" MinWidth="160" />
                                                <Button x:Name="BtnGDriveLogout" Content="退出登录" Click="OnGDriveLogoutClick" IsVisible="False" MinWidth="96" />
                                            </StackPanel>
                                        </Grid>
                                        <ContentControl x:Name="GDriveSyncHost">
                                            <!-- 两家服务商共用这一组控件，由 UpdateCloudProviderVisibility 搬动宿主。
                                                 状态说明自然撑高；开关靠左，历史与主操作集中靠右。 -->
                                            <StackPanel x:Name="PnlCloudAuto" Spacing="8">
                                                <TextBlock x:Name="TxtCloudAutoStatus" Classes="fieldHint" TextWrapping="Wrap" Text="自动同步已关闭。"
                                                           ToolTip.Tip="自动同步：配置修改后约 10 秒同步到其他设备；启动、联网恢复及每 5 分钟检查云端。" />
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center">
                                                        <TextBlock Text="自动同步" Classes="fieldLabel" />
                                                        <controls:ContinuousBorder Classes="segmentedGroup" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <RadioButton x:Name="RadCloudAutoOff" GroupName="GrpCloudAuto" Classes="segmented" Content="关闭" />
                                                                <RadioButton x:Name="RadCloudAutoOn" GroupName="GrpCloudAuto" Classes="segmented" Content="开启" />
                                                            </StackPanel>
                                                        </controls:ContinuousBorder>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button x:Name="BtnCloudVersions" Content="云端版本" Classes="secondary" Click="OnCloudVersionsClick" IsVisible="False" MinWidth="112" Width="112"
                                                                ToolTip.Tip="打开云端版本管理：查看历史版本，本机与云端不一致时在这里选要用哪一份。" />
                                                        <Button x:Name="BtnGDriveDownload" Content="恢复手动备份" Click="OnGDriveDownloadClick" IsVisible="False" MinWidth="112" Width="112" ToolTip.Tip="恢复单独上传的手动备份文件；自动同步历史请打开云端版本。" />
                                                        <Button x:Name="BtnGDriveUpload" Content="上传手动备份" Classes="primary" Click="OnGDriveUploadClick" IsVisible="False" MinWidth="112" Width="112" />
                                                        <Button x:Name="BtnWebDavDownload" Content="恢复手动备份" Click="OnWebDavDownloadClick" IsVisible="False" MinWidth="112" Width="112" ToolTip.Tip="恢复单独上传的手动备份文件；自动同步历史请打开云端版本。" />
                                                        <Button x:Name="BtnWebDavUpload" Content="上传手动备份" Classes="primary" Click="OnWebDavUploadClick" IsVisible="False" MinWidth="112" Width="112" />
                                                        <Button x:Name="BtnCloudSyncNow" Content="立即同步" Classes="primary" Click="OnCloudSyncNowClick" MinWidth="112" Width="112" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </ContentControl>
                                    </StackPanel>
                                </controls:ContinuousBorder>

                                <!-- ===== WebDAV ===== -->
                                <controls:ContinuousBorder Classes="card" x:Name="WebDavCard" IsVisible="False">
                                    <StackPanel Spacing="12">
                                        <!-- 标签一律走 fieldLabel：旧写法在这里硬写了 SctTextMutedBrush，
                                             而浅色档 Muted 与正文同值（#222222），等于没写，只有深色档偷偷变淡。 -->
                                        <Grid Classes="fieldRow" ColumnDefinitions="96,*">
                                            <TextBlock Grid.Column="0" Text="地址" Classes="fieldLabel" />
                                            <TextBox Grid.Column="1" x:Name="TxtWebDavUrl" Watermark="https://example.com/dav/path" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Classes="fieldRow" ColumnDefinitions="96,*">
                                            <TextBlock Grid.Column="0" Text="用户名" Classes="fieldLabel" />
                                            <TextBox Grid.Column="1" x:Name="TxtWebDavUsername" Watermark="WebDAV 账号" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Classes="fieldRow" ColumnDefinitions="96,*">
                                            <TextBlock Grid.Column="0" Text="密码" Classes="fieldLabel" />
                                            <Grid Grid.Column="1" VerticalAlignment="Center">
<TextBox x:Name="TxtWebDavPassword" Watermark="密码/ Token，WebDAV 认证凭据" PasswordChar="*" Padding="10,6,36,6" />
<Button Classes="eyeToggle" HorizontalAlignment="Right" Margin="0,0,4,0" Click="OnTogglePasswordVisibility">
<Panel>
<Path Classes="eyeIcon" Data="M12,4.5C7,4.5 2.73,7.61 1,12c1.73,4.39 6,7.5 11,7.5s9.27,-3.11 11,-7.5c-1.73,-4.39 -6,-7.5 -11,-7.5zM12,17c-2.76,0 -5,-2.24 -5,-5s2.24,-5 5,-5 5,2.24 5,5 -2.24,5 -5,5zM12,9c-1.66,0 -3,1.34 -3,3s1.34,3 3,3 3,-1.34 3,-3 -1.34,-3 -3,-3z" />
<Path Classes="eyeOffIcon" Data="M12,7c2.76,0 5,2.24 5,5 0,0.65 -0.13,1.26 -0.36,1.83l2.92,2.92c1.51,-1.26 2.7,-2.89 3.43,-4.75 -1.73,-4.39 -6,-7.5 -11,-7.5 -1.4,0 -2.74,0.25 -3.98,0.7l2.16,2.16C10.74,7.13 11.35,7 12,7zM2,4.27l2.28,2.28 0.46,0.46C3.08,8.3 1.78,10.02 1,12c1.73,4.39 6,7.5 11,7.5 1.55,0 3.03,-0.3 4.38,-0.84l0.42,0.42L19.73,22 21,20.73 3.27,3 2,4.27zM7.53,9.8l1.55,1.55c-0.05,0.21 -0.08,0.43 -0.08,0.65 0,1.66 1.34,3 3,3 0.22,0 0.44,-0.03 0.65,-0.08l1.55,1.55c-0.67,0.33 -1.41,0.53 -2.2,0.53 -2.76,0 -5,-2.24 -5,-5 0,-0.79 0.2,-1.53 0.53,-2.2z" IsVisible="False" />
</Panel>
</Button>
</Grid>
                                        </Grid>
                                        <Grid Classes="fieldRow" ColumnDefinitions="96,*">
                                            <TextBlock Grid.Column="0" Text="文件名" Classes="fieldLabel" />
                                            <TextBox Grid.Column="1" x:Name="TxtWebDavFileName" Watermark="yuSnip-config-v1.json" VerticalAlignment="Center" />
                                        </Grid>
                                        <controls:ContinuousBorder Classes="softDivider" />
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <TextBlock Text="连接测试" Classes="fieldLabel" />
                                            <Button Grid.Column="1" x:Name="BtnWebDavTest" Content="测试连接" Click="OnWebDavTestClick" VerticalAlignment="Center" />
                                        </Grid>
                                        <ContentControl x:Name="WebDavSyncHost" />
                                    </StackPanel>
                                </controls:ContinuousBorder>

                                <!-- ===== 本地配置文件 ===== -->
                                <controls:ContinuousBorder Classes="card">
                                    <StackPanel Spacing="12">
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="配置文件路径" Classes="fieldLabel" />
                                                <TextBlock x:Name="TxtCloudConfigPath" Classes="fieldHint" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="打开目录" Classes="primary" Click="OnCloudOpenDirClick" VerticalAlignment="Center" />
                                        </Grid>
                                        <controls:ContinuousBorder Classes="softDivider" />
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <TextBlock Text="导出当前全部配置为备份文件，或从备份文件恢复配置。" Classes="fieldHint" VerticalAlignment="Center" Margin="0" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Content="导出配置" Click="OnCloudExportClick" MinWidth="96" />
                                                <Button Content="导入配置" Click="OnCloudImportClick" MinWidth="96" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </controls:ContinuousBorder>
                            </StackPanel>


                            <!-- ============ 依赖运行 ============ -->
                            <!-- 三个依赖同卡三行（2026-09-25 稿「依赖运行」02 节方案甲）：
                                 行内一律「左名称＋说明 / 右胶囊＋一枚按钮」，与设置页既有 fieldRow 同构；
                                 下载中时该行就地长出通宽进度轨，页面不跳。按钮只有一枚，语义随状态换字换档。 -->
                            <StackPanel x:Name="PanelDeps" Spacing="24" IsVisible="False">
                                <StackPanel Spacing="8" Margin="0,0,0,4">
                                    <TextBlock Text="依赖运行" Classes="pageTitle" />
                                    <TextBlock Text="识别、抠图与录屏所需的运行组件，首次使用时自动下载。" Classes="pageDescription" />
                                </StackPanel>

                                <controls:ContinuousBorder x:Name="CardDeps" Classes="card">
                                    <StackPanel Spacing="10">
                                        <!-- OCR -->
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="OCR 识别引擎" Classes="fieldLabel" />
                                                    <controls:ContinuousBorder x:Name="PillDepOcr" Classes="statusPill">
                                                        <TextBlock x:Name="TxtDepOcrPill" Text="未下载" />
                                                    </controls:ContinuousBorder>
                                                </StackPanel>
                                                <TextBlock Text="截图取字、翻译与贴图取字的文字识别模型" Classes="fieldHint" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button x:Name="BtnDepUninstallOcr" Content="卸载" MinWidth="76" Classes="danger ghost" IsVisible="False" Click="OnDepUninstallClick" />
                                                <Button x:Name="BtnDepOcr" Content="下载" MinWidth="88" Classes="primary" Click="OnDepActionClick" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel x:Name="PnlDepOcrDl" Spacing="6" IsVisible="False">
                                            <controls:ContinuousBorder x:Name="TrackDepOcr" Classes="dlTrack">
                                                <controls:ContinuousBorder x:Name="FillDepOcr" Classes="dlFill" Width="0" />
                                            </controls:ContinuousBorder>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="TxtDepOcrDl" Text="" Classes="fieldHint" Margin="0" />
                                                <TextBlock Grid.Column="1" Text="可关窗，下载继续" Classes="fieldHint" Margin="0" />
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtDepOcrErr" Text="" Classes="fieldHint" IsVisible="False" />
                                        <controls:ContinuousBorder Classes="softDivider" />

                                        <!-- 抠图 -->
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="抠图模型" Classes="fieldLabel" />
                                                    <controls:ContinuousBorder x:Name="PillDepMatting" Classes="statusPill">
                                                        <TextBlock x:Name="TxtDepMattingPill" Text="未下载" />
                                                    </controls:ContinuousBorder>
                                                </StackPanel>
                                                <TextBlock Text="一键去背景，含通用与人像两档" Classes="fieldHint" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button x:Name="BtnDepUninstallMatting" Content="卸载" MinWidth="76" Classes="danger ghost" IsVisible="False" Click="OnDepUninstallClick" />
                                                <Button x:Name="BtnDepMatting" Content="下载" MinWidth="88" Classes="primary" Click="OnDepActionClick" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel x:Name="PnlDepMattingDl" Spacing="6" IsVisible="False">
                                            <controls:ContinuousBorder x:Name="TrackDepMatting" Classes="dlTrack">
                                                <controls:ContinuousBorder x:Name="FillDepMatting" Classes="dlFill" Width="0" />
                                            </controls:ContinuousBorder>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="TxtDepMattingDl" Text="" Classes="fieldHint" Margin="0" />
                                                <TextBlock Grid.Column="1" Text="可关窗，下载继续" Classes="fieldHint" Margin="0" />
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtDepMattingErr" Text="" Classes="fieldHint" IsVisible="False" />
                                        <controls:ContinuousBorder Classes="softDivider" />

                                        <!-- 下载组件与当前使用来源分开显示，便于保留默认组件和切换。 -->
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="FFmpeg 录屏引擎" Classes="fieldLabel" />
                                                    <controls:ContinuousBorder x:Name="PillDepFfmpeg" Classes="statusPill">
                                                        <TextBlock x:Name="TxtDepFfmpegPill" Text="未下载" />
                                                    </controls:ContinuousBorder>
                                                </StackPanel>
                                                <TextBlock Text="由 yuSnip 下载和管理的默认组件" Classes="fieldHint" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button x:Name="BtnDepUninstallFfmpeg" Content="卸载" MinWidth="76" Classes="danger ghost" IsVisible="False" Click="OnDepUninstallClick" />
                                                <Button x:Name="BtnDepFfmpeg" Content="下载" MinWidth="88" Classes="primary" Click="OnDepActionClick" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel x:Name="PnlDepFfmpegDl" Spacing="6" IsVisible="False">
                                            <controls:ContinuousBorder x:Name="TrackDepFfmpeg" Classes="dlTrack">
                                                <controls:ContinuousBorder x:Name="FillDepFfmpeg" Classes="dlFill" Width="0" />
                                            </controls:ContinuousBorder>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="TxtDepFfmpegDl" Text="" Classes="fieldHint" Margin="0" />
                                                <TextBlock Grid.Column="1" Text="可关窗，下载继续" Classes="fieldHint" Margin="0" />
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtDepFfmpegErr" Text="" Classes="fieldHint" IsVisible="False" />
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="FFmpeg 来源" Classes="fieldLabel" />
                                                <TextBlock x:Name="TxtFfmpegSourceStatus" Text="使用默认组件" Classes="fieldHint" />
                                                <TextBlock x:Name="TxtFfmpegSourcePath" Classes="fieldHint" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" IsVisible="False" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button x:Name="BtnResetFfmpegSource" Content="恢复默认" Classes="secondary"
                                                        IsVisible="False" Click="OnResetFfmpegSourceClick" />
                                                <Button x:Name="BtnPickFfmpegDirectory" Content="选择目录…" Classes="secondary"
                                                        ToolTip.Tip="选择包含 ffmpeg.exe 的目录，或包含 bin 文件夹的 FFmpeg 解压目录。"
                                                        Click="OnPickFfmpegDirectoryClick" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </controls:ContinuousBorder>

                                <controls:ContinuousBorder Classes="card">
                                    <StackPanel Spacing="10">
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="存放位置" Classes="fieldLabel" />
                                                <TextBlock x:Name="TxtDepsStore" Text="" Classes="fieldHint" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Content="打开目录" MinWidth="88" Classes="secondary" Click="OnOpenDepsDirClick" />
                                            </StackPanel>
                                        </Grid>
                                        <controls:ContinuousBorder Classes="softDivider" />
                                        <Grid Classes="fieldRow" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="fieldInfo" Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="离线导入" Classes="fieldLabel" />
                                                <TextBlock Text="网络不便时，选已下好的依赖包压缩包" Classes="fieldHint" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="选择压缩包…" MinWidth="110" Classes="secondary" VerticalAlignment="Center" Click="OnImportDepPackageClick" />
                                        </Grid>
                                    </StackPanel>
                                </controls:ContinuousBorder>
                            </StackPanel>


                            <!-- ============ 工具栏与样式 ============ -->
                            <!-- 三块顺序＝截图工具栏 → 组 → 工具池：一级栏是唯一的"工作台"，另两块只是料与仓库。
                                 组卡一律并排（WrapPanel），上栏／撤栏全靠拖拽，本页不再有任何"上栏"按钮。
                                 常驻说明各压到一行以内，完整引导只在空状态出现（见 设计规范.md §4.2 解释文字档）。 -->
                            <StackPanel x:Name="PanelToolbar" Spacing="24" IsVisible="False">
                                <TextBlock Text="工具栏与样式" Classes="pageTitle" Margin="0,0,0,4" />

                                <!-- 截图选框样式卡片：标题行（含线型）→ 实时预览 → 颜色 → 粗细仪表盘。
                                     三项参数都只作用于同一处视觉，故同卡承载：改任意一项都能在预览里立刻看到结果 -->
                                <controls:ContinuousBorder Classes="card">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="截图选框样式" Classes="cardTitle" Margin="0" />
                                                <TextBlock Text="截图时选区边框的线型、颜色与粗细，下方预览实时生效。" Classes="fieldHint" Margin="0" />
                                            </StackPanel>
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadSelectionBorderDashed" GroupName="GrpSelectionBorderStyle" Classes="segmented" Content="虚线" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadSelectionBorderSolid" GroupName="GrpSelectionBorderStyle" Classes="segmented" Content="实线" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>

                                        <!-- 实时预览：四向遮罩拼出中间镂空＝选区，遮罩色与真实截图同源（SctPreviewMaskBrush）。
                                             选框的描边色/线型/粗细全部由代码按当前设置刷（UpdateSelectionBorderPreview） -->
                                        <controls:ContinuousBorder Classes="previewStage" Height="152">
                                            <Grid RowDefinitions="28,96,28" ColumnDefinitions="*,210,*">
                                                <!-- 模拟屏幕内容：纯装饰，用来衬出遮罩压暗后的明暗反差 -->
                                                <StackPanel Grid.RowSpan="3" Grid.ColumnSpan="3" Margin="22,18" Spacing="11">
                                                    <Rectangle Classes="previewContent" Height="12" HorizontalAlignment="Stretch" />
                                                    <Rectangle Classes="previewContent" Height="8" Width="188" HorizontalAlignment="Left" />
                                                    <Rectangle Classes="previewContent" Height="8" Width="132" HorizontalAlignment="Left" />
                                                    <Rectangle Classes="previewContent" Height="30" Width="92" HorizontalAlignment="Right" />
                                                </StackPanel>

                                                <!-- 遮罩四向：上 / 下 / 左 / 右 -->
                                                <Rectangle Grid.Row="0" Grid.ColumnSpan="3" Classes="previewMask" />
                                                <Rectangle Grid.Row="2" Grid.ColumnSpan="3" Classes="previewMask" />
                                                <Rectangle Grid.Row="1" Grid.Column="0" Classes="previewMask" />
                                                <Rectangle Grid.Row="1" Grid.Column="2" Classes="previewMask" />

                                                <!-- 选区本体：边框 + 四角控制点 + 上沿尺寸标签 -->
                                                <Grid Grid.Row="1" Grid.Column="1">
                                                    <Rectangle x:Name="PrevSelectionBorder" Stroke="White" StrokeThickness="2" />
                                                    <controls:ContinuousBorder Classes="previewHandle" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3.5,-3.5,0,0" />
                                                    <controls:ContinuousBorder Classes="previewHandle" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3.5,-3.5,0" />
                                                    <controls:ContinuousBorder Classes="previewHandle" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-3.5,0,0,-3.5" />
                                                    <controls:ContinuousBorder Classes="previewHandle" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3.5,-3.5" />
                                                    <controls:ContinuousBorder Classes="previewSizeTag" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-24,0,0">
                                                        <TextBlock Classes="previewSizeText" Text="640 × 360" />
                                                    </controls:ContinuousBorder>
                                                </Grid>
                                            </Grid>
                                        </controls:ContinuousBorder>

                                        <!-- 颜色：取色入口 + 预设色板（数据驱动，选中态由代码挂 .active）+ 可编辑 HEX。
                                             取色按钮与预设色块**共用同一套瓦片几何**（Button.colorTile / Border.colorTileFill），
                                             故两者等高、环槽一致，读起来是一整条色带而不是"一个按钮加一排色块"。
                                             整条（取色 + 5 枚预设）塞进同一个 Spacing=0 的内层 StackPanel，
                                             相邻内芯间距才是均匀的 8px（若把取色按钮留在外层，它到首枚预设的间距会变成 16px）。 -->
                                        <Grid MinHeight="38" ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="颜色" Classes="fieldLabel" Margin="0" />
                                                <TextBlock Text="点选预设色，或用左侧取色器自定义；默认白色。" Classes="fieldHint" Margin="0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                                    <!-- 取色入口：六色彩虹底暗示"任意色"，中心小色块回显当前值 -->
                                                    <Button x:Name="BtnSelectionBorderColor" Classes="colorTile"
                                                            ToolTip.Tip="自定义边框颜色…" Click="OnSelectionBorderColorClick">
                                                        <Grid Width="24" Height="24">
                                                            <controls:ContinuousBorder Classes="colorTileRainbow">
                                                                <controls:ContinuousBorder.Background>
                                                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                                        <GradientStop Color="#FFFF4D4F" Offset="0" />
                                                                        <GradientStop Color="#FFFFC53D" Offset="0.22" />
                                                                        <GradientStop Color="#FF52C41A" Offset="0.42" />
                                                                        <GradientStop Color="#FF13C2C2" Offset="0.62" />
                                                                        <GradientStop Color="#FF2F54EB" Offset="0.8" />
                                                                        <GradientStop Color="#FFEB2F96" Offset="1" />
                                                                    </LinearGradientBrush>
                                                                </controls:ContinuousBorder.Background>
                                                            </controls:ContinuousBorder>
                                                            <controls:ContinuousBorder x:Name="BorderSelectionColorPreview" Classes="colorTileRainbowPreview" />
                                                        </Grid>
                                                    </Button>
                                                    <StackPanel x:Name="PanelSelectionColorChips" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBox x:Name="TxtSelectionBorderColorHex" Classes="hexInput" Text="#FFFFFF"
                                                         KeyDown="OnSelectionBorderHexKeyDown" LostFocus="OnSelectionBorderHexLostFocus"
                                                         TextChanged="OnSelectionBorderHexChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- 选框边框粗细：只有 0~5 共 6 个档位，属离散选择而非连续量，
                                             故与线型同款走分段选择器；凹槽滑块留给「检测元素」那类真正连续的量程。
                                             0 表示不绘制边框 -->
                                        <Grid MinHeight="38" ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="粗细" Classes="fieldLabel" Margin="0" />
                                                <TextBlock Text="截图时选区边框的线条粗细（像素），0 表示不绘制边框。" Classes="fieldHint" Margin="0" />
                                            </StackPanel>
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadSelectionBorderThickness0" Tag="0" GroupName="GrpSelectionBorderThickness"
                                                                 Classes="segmented" Content="0" IsCheckedChanged="OnSelectionBorderThicknessCheckedChanged" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadSelectionBorderThickness1" Tag="1" GroupName="GrpSelectionBorderThickness"
                                                                 Classes="segmented" Content="1" IsCheckedChanged="OnSelectionBorderThicknessCheckedChanged" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadSelectionBorderThickness2" Tag="2" GroupName="GrpSelectionBorderThickness"
                                                                 Classes="segmented" Content="2" IsChecked="True" IsCheckedChanged="OnSelectionBorderThicknessCheckedChanged" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadSelectionBorderThickness3" Tag="3" GroupName="GrpSelectionBorderThickness"
                                                                 Classes="segmented" Content="3" IsCheckedChanged="OnSelectionBorderThicknessCheckedChanged" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadSelectionBorderThickness4" Tag="4" GroupName="GrpSelectionBorderThickness"
                                                                 Classes="segmented" Content="4" IsCheckedChanged="OnSelectionBorderThicknessCheckedChanged" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadSelectionBorderThickness5" Tag="5" GroupName="GrpSelectionBorderThickness"
                                                                 Classes="segmented" Content="5" IsCheckedChanged="OnSelectionBorderThicknessCheckedChanged" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>
                                    </StackPanel>
                                </controls:ContinuousBorder>

                                <controls:ContinuousBorder Classes="card">
                                    <StackPanel Spacing="10">
                                        <!-- 三块同一套「标题 + 紧贴其下的一行说明」：说明装进标题自己的无间距
                                             StackPanel（间距 0，与「关于」页「当前版本 / v1.0.17」完全同款），
                                             不吃卡片级 Spacing=10，标题与说明严格贴合；右侧只留操作按钮/数值 -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock x:Name="ToolbarSceneTitle" Text="截图工具栏" Classes="cardTitle" Margin="0" />
                                                <TextBlock x:Name="ToolbarLayoutUsage" Classes="fieldHint" Margin="0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <ComboBox x:Name="CmbToolbarScene" Width="124" SelectedIndex="0"
                                                          AutomationProperties.Name="编辑工具栏" SelectionChanged="OnToolbarSceneChanged">
                                                    <ComboBoxItem Content="截图" />
                                                    <ComboBoxItem Content="贴图标注" />
                                                    <ComboBoxItem Content="录屏准备" />
                                                    <ComboBoxItem Content="录制中" />
                                                    <ComboBoxItem Content="录屏预览" />
                                                    <ComboBoxItem Content="长截图" />
                                                </ComboBox>
                                                <Button x:Name="BtnToolbarReset" Content="恢复默认布局" MinWidth="100" Click="OnToolbarResetClick" />
                                            </StackPanel>
                                        </Grid>
                                        <ScrollViewer x:Name="ToolbarLayoutScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="-20,-12">
                                            <Border Padding="20,12" Background="Transparent">
                                            <controls:ContinuousBorder x:Name="ToolbarPreviewSurface" Background="{DynamicResource SctControlBarOuterBrush}" CornerRadius="{DynamicResource SctRadiusToolbar}" Padding="1" HorizontalAlignment="Left" BoxShadow="0 5 20 0 #33000000">
                                                <controls:ContinuousBorder.Styles>
                                                    <StyleInclude Source="/Themes/Toolbar.axaml" />
                                                </controls:ContinuousBorder.Styles>
                                                <controls:ContinuousBorder Background="{DynamicResource SctPanelBrush}" CornerRadius="{DynamicResource SctRadiusToolbarInner}" Padding="8,4" MinHeight="42">
                                                    <StackPanel x:Name="ToolbarLayoutPreview" Orientation="Horizontal" VerticalAlignment="Center" />
                                                </controls:ContinuousBorder>
                                            </controls:ContinuousBorder>
                                            </Border>
                                        </ScrollViewer>
                                    </StackPanel>
                                </controls:ContinuousBorder>

                                <controls:ContinuousBorder Classes="card" x:Name="ToolbarGroupsArea">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="组" Classes="cardTitle" Margin="0" />
                                                <TextBlock Text="2 枚起 · 数量不限 · 拖进上方工具栏才生效" Classes="fieldHint" Margin="0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" x:Name="ToolbarGroupUsage" Classes="fieldHint" VerticalAlignment="Center" Margin="0" />
                                        </Grid>
                                        <!-- 等宽列自适应网格：有组卡时显示，列数由代码按可用宽度现算（固定宽度 + 换行会让右侧参差） -->
                                        <UniformGrid x:Name="ToolbarGroupCards" Columns="1" />

                                        <!-- 空状态引导区：一张组卡都没有时显示，通栏居中虚线卡片，替代 UniformGrid 里支离破碎的排列 -->
                                        <Grid x:Name="ToolbarGroupEmpty" IsVisible="False" MinHeight="68">
                                            <Rectangle Classes="tbGroupDash" Margin="0.5" />
                                            <Button Classes="tbGroupNew" Click="OnToolbarNewGroupClick"
                                                    ToolTip.Tip="新建一张空组卡，从工具池往里面拖工具">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                                    <TextBlock x:Name="TxtToolbarGroupEmptyTitle" Text="＋ 新建组" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    <TextBlock Text="点击新建第一张组卡，从下方工具池拖入至少 2 枚工具组合"
                                                               Classes="fieldHint" Margin="0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </controls:ContinuousBorder>

                                <controls:ContinuousBorder Classes="card" x:Name="ToolbarPoolCard">
                                    <Grid>
                                        <StackPanel Spacing="10">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="工具池" Classes="cardTitle" Margin="0" />
                                                <TextBlock Text="拖到上面任意位置" Classes="fieldHint" Margin="0" />
                                            </StackPanel>
                                            <WrapPanel x:Name="ToolbarButtonPool" />
                                        </StackPanel>

                                        <!-- 拖拽组至工具池时的解散/删除紫色提示遮罩（2026-09-14（六）） -->
                                        <controls:ContinuousBorder x:Name="ToolbarPoolDropMask"
                                                IsVisible="False"
                                                Margin="-24,-20"
                                                CornerRadius="{DynamicResource SctRadiusCard}"
                                                BorderThickness="1.5"
                                                BorderBrush="{DynamicResource SctAccentBrush}"
                                                Background="{DynamicResource SctPanelBrush}"
                                                Opacity="0.96"
                                                IsHitTestVisible="False">
                                            <Grid>
                                                <!-- 半透明品牌紫雾面底色 -->
                                                <controls:ContinuousBorder x:Name="ToolbarPoolDropMaskTint"
                                                        CornerRadius="{DynamicResource SctRadiusCard}"
                                                        Background="{DynamicResource SctAccentBrush}"
                                                        Opacity="0.12" />
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                                    <controls:ContinuousBorder x:Name="ToolbarPoolDropMaskIconWrap"
                                                            Width="40" Height="40" CornerRadius="{DynamicResource SctRadiusSidebar}"
                                                            Background="{DynamicResource SctAccentBrush}"
                                                            HorizontalAlignment="Center">
                                                        <!-- 垃圾桶矢量图标：通过几何平移微调 (+2px, 0px) 消除 Uniform 拉伸非正方形图形左锚定偏差，在圆形内绝对居中 -->
                                                        <Path x:Name="ToolbarPoolDropMaskIcon"
                                                              Width="18" Height="18" Stretch="Uniform"
                                                              Fill="#FFFFFF"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              RenderTransform="translate(2px, 0px)"
                                                              Data="{x:Static win:OcrIconGeometry.Delete}" />
                                                    </controls:ContinuousBorder>
                                                    <TextBlock x:Name="ToolbarPoolDropMaskTitle"
                                                               Text="拖拽到此处解散该组"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SctAccentBrush}"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="ToolbarPoolDropMaskDesc"
                                                               Text="组内所有工具将全数归还工具池"
                                                               FontSize="12"
                                                               Classes="fieldHint"
                                                               Margin="0"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </controls:ContinuousBorder>
                                    </Grid>
                                </controls:ContinuousBorder>
                            </StackPanel>


                            <!-- ============ 使用统计 ============ -->
                            <StackPanel x:Name="PanelStats" Spacing="24" IsVisible="False">
                                <StackPanel Spacing="8" Margin="0,0,0,4">
                                    <TextBlock Text="使用统计" Classes="pageTitle" />
                                    <TextBlock Text="本机使用次数与趋势，仅记录本机，不参与云同步。" Classes="pageDescription" />
                                </StackPanel>

                                <!-- 使用统计：本机数据，不同步、不导出，仅支持一键清空。
                                     结构为「头部 + 五联数值 + 趋势图 + 图例 + 占比条 + 免责」，
                                     全部装在**同一张** card 里（§1 去嵌套：不做卡中卡）。
                                     五联用等宽 1×5 铺满内容区（禁止左对齐固定宽度，见 设计规范.md），
                                     数值为所选区间次数（20px SemiBold + 系列色），下方标明时间范围。 -->
                                <controls:ContinuousBorder Classes="card">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtStatsSummary" Classes="fieldHint" Margin="0" />
                                            </StackPanel>
                                            <!-- 时间范围统一控制次数、图表与占比，属视图偏好，刻意不落盘 -->
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadStatsRange7" GroupName="GrpStatsRange" Classes="segmented" Content="7 天" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadStatsRange30" GroupName="GrpStatsRange" Classes="segmented" Content="30 天" IsChecked="True" />
                                                    <Rectangle Classes="segmentedDivider" />
                                                    <RadioButton x:Name="RadStatsRange90" GroupName="GrpStatsRange" Classes="segmented" Content="90 天" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                            <Button Grid.Column="2" x:Name="BtnStatsClear" Content="清空统计"
                                                    MinWidth="88" VerticalAlignment="Center" Click="OnStatsClearClick" />
                                        </Grid>

                                        <controls:ContinuousBorder Classes="softDivider" />

                                        <!-- 五联数值：等宽 1×5 + 中缝发丝竖线。
                                             间距用 Margin 手写：Avalonia 11 的 Grid 没有 RowSpacing/ColumnSpacing
                                             （那是 WPF/WinUI 属性），写上去会在编译期抛 AVLN2000。 -->
                                        <Grid ColumnDefinitions="*,1,*,1,*,1,*,1,*">
                                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,10,0">
                                                <TextBlock x:Name="TxtStatScreenshot" Text="0" FontSize="20" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SctTextPrimaryBrush}" />
                                                <TextBlock Text="截图次数" Classes="fieldHint" Margin="0" />
                                                <TextBlock x:Name="TxtStatScreenshotDelta" Classes="fieldHint" Margin="0" />
                                            </StackPanel>
                                            <Rectangle Grid.Column="1" Width="1" Margin="0,2" Fill="{DynamicResource SctSoftBorderBrush}" />
                                            <StackPanel Grid.Column="2" Spacing="2" Margin="10,0">
                                                <TextBlock x:Name="TxtStatAiChat" Text="0" FontSize="20" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SctTextPrimaryBrush}" />
                                                <TextBlock Text="AI 对话次数" Classes="fieldHint" Margin="0" />
                                                <TextBlock x:Name="TxtStatAiChatDelta" Classes="fieldHint" Margin="0" />
                                            </StackPanel>
                                            <Rectangle Grid.Column="3" Width="1" Margin="0,2" Fill="{DynamicResource SctSoftBorderBrush}" />
                                            <StackPanel Grid.Column="4" Spacing="2" Margin="10,0">
                                                <TextBlock x:Name="TxtStatOcr" Text="0" FontSize="20" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SctTextPrimaryBrush}" />
                                                <TextBlock Text="OCR 次数" Classes="fieldHint" Margin="0" />
                                                <TextBlock x:Name="TxtStatOcrDelta" Classes="fieldHint" Margin="0" />
                                            </StackPanel>
                                            <Rectangle Grid.Column="5" Width="1" Margin="0,2" Fill="{DynamicResource SctSoftBorderBrush}" />
                                            <StackPanel Grid.Column="6" Spacing="2" Margin="10,0">
                                                <TextBlock x:Name="TxtStatTranslate" Text="0" FontSize="20" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SctTextPrimaryBrush}" />
                                                <TextBlock Text="翻译次数" Classes="fieldHint" Margin="0" />
                                                <TextBlock x:Name="TxtStatTranslateDelta" Classes="fieldHint" Margin="0" />
                                            </StackPanel>
                                            <Rectangle Grid.Column="7" Width="1" Margin="0,2" Fill="{DynamicResource SctSoftBorderBrush}" />
                                            <StackPanel Grid.Column="8" Spacing="2" Margin="10,0,0,0">
                                                <TextBlock x:Name="TxtStatSticker" Text="0" FontSize="20" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SctTextPrimaryBrush}" />
                                                <TextBlock Text="贴图次数" Classes="fieldHint" Margin="0" />
                                                <TextBlock x:Name="TxtStatStickerDelta" Classes="fieldHint" Margin="0" />
                                            </StackPanel>
                                        </Grid>

                                        <controls:ContinuousBorder Classes="softDivider" />

                                        <!-- 趋势图（自绘堆叠柱，见 Controls/UsageChart.cs） -->
                                        <controls:UsageChart x:Name="ChartUsage" Height="180" IsAreaChart="True" />

                                        <!-- 图例：色点 + 名称，色值与图表系列一一对应 -->
                                        <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource SctChartSeries1Brush}" />
                                                <TextBlock Text="截图" Classes="fieldHint" Margin="0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource SctChartSeries2Brush}" />
                                                <TextBlock Text="AI 对话" Classes="fieldHint" Margin="0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource SctChartSeries3Brush}" />
                                                <TextBlock Text="OCR" Classes="fieldHint" Margin="0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource SctChartSeries4Brush}" />
                                                <TextBlock Text="翻译" Classes="fieldHint" Margin="0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource SctChartSeries5Brush}" />
                                                <TextBlock Text="贴图" Classes="fieldHint" Margin="0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>

                                        <controls:ContinuousBorder Classes="softDivider" />

                                        <!-- 区间占比条：一条 8px 堆叠横条 + 右侧主项百分比。
                                             刻意不做饼图/环形图——一条横条在 24,20 卡片内边距下信息密度更高，
                                             也不违反"去多余装饰"。列宽按占比动态设 Star，段底色走系列 Token。 -->
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="时段构成" Classes="fieldHint" Margin="0" />
                                                <TextBlock Grid.Column="1" x:Name="TxtStatsRatioHint" Classes="fieldHint" Margin="0" />
                                            </Grid>
                                            <controls:ContinuousBorder Height="8" CornerRadius="{DynamicResource SctRadiusSmall}" ClipToBounds="True"
                                                    Background="{DynamicResource SctSubtleBrush}">
                                                <Grid x:Name="GridStatsRatio" ColumnDefinitions="*,*,*,*,*">
                                                    <controls:ContinuousBorder Grid.Column="0" Background="{DynamicResource SctChartSeries1Brush}" />
                                                    <controls:ContinuousBorder Grid.Column="1" Background="{DynamicResource SctChartSeries2Brush}" />
                                                    <controls:ContinuousBorder Grid.Column="2" Background="{DynamicResource SctChartSeries3Brush}" />
                                                    <controls:ContinuousBorder Grid.Column="3" Background="{DynamicResource SctChartSeries4Brush}" />
                                                    <controls:ContinuousBorder Grid.Column="4" Background="{DynamicResource SctChartSeries5Brush}" />
                                                </Grid>
                                            </controls:ContinuousBorder>
                                        </StackPanel>

                                        <controls:ContinuousBorder Classes="softDivider" />

                                        <TextBlock Text="仅记录本机成功调用的次数，不含内容与截图本身；不参与云同步，也不随配置导出。趋势保留最近 90 天；贴图从升级后开始记录，旧数据无法补算。截图与贴图分别累计，可能同时计数。清空后无法恢复。"
                                                   Classes="fieldHint" Margin="0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </controls:ContinuousBorder>
                            </StackPanel>


                            <!-- ============ 关于 ============ -->
                            <StackPanel x:Name="PanelAbout" Spacing="16" IsVisible="False">
                                <StackPanel Spacing="8" Margin="0,0,0,12">
                                    <TextBlock Text="关于" Classes="pageTitle" />
                                    <TextBlock Text="让灵感随手留存，感谢一路有你。" Classes="pageDescription" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,20,280">
                                    <controls:ContinuousBorder Classes="overviewCard" Padding="24">
                                        <Grid RowDefinitions="Auto,12,Auto,20,*,16,Auto">
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14">
                                                <Image x:Name="ImgAppLogo" Source="/Assets/Black.ico" Width="52" Height="52" VerticalAlignment="Center" />
                                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="yuSnip" FontSize="28" FontWeight="Bold" />
                                                    <TextBlock Text="让截图与贴图更顺手" Classes="secondary" />
                                                </StackPanel>
                                            </StackPanel>
                                            <controls:ContinuousBorder x:Name="AboutIdentityDivider" Grid.Row="2" Classes="softDivider" />
                                            <Grid Grid.Row="4" RowDefinitions="32,32,32,32,32,32" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                                <TextBlock Grid.Row="0" Text="作者" Classes="fieldLabel" Margin="0,0,20,0" Foreground="{DynamicResource SctTextMutedBrush}" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="北京林或西" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Text="交流社区" Classes="fieldLabel" Margin="0,0,20,0" Foreground="{DynamicResource SctTextMutedBrush}" />
                                                <Button Grid.Row="1" Grid.Column="1" Classes="link" HorizontalAlignment="Left" Click="OnJoinQQGroupClick" ToolTip.Tip="加入 Quicker地球村 · QQ群 453478357">
                                                    <TextBlock Text="Quicker地球村 · 453478357" TextWrapping="Wrap" />
                                                </Button>
                                                <TextBlock Grid.Row="2" Text="官方网站" Classes="fieldLabel" Margin="0,0,20,0" Foreground="{DynamicResource SctTextMutedBrush}" />
                                                <Button Grid.Row="2" Grid.Column="1" Classes="link" Content="yusnip.top" HorizontalAlignment="Left" Click="OnOpenWebsiteClick" ToolTip.Tip="https://yusnip.top" />
                                                <TextBlock Grid.Row="3" Text="GitHub" Classes="fieldLabel" Margin="0,0,20,0" Foreground="{DynamicResource SctTextMutedBrush}" />
                                                <Button Grid.Row="3" Grid.Column="1" Classes="link" Content="linhuoxi/yuSnip" HorizontalAlignment="Left" Click="OnOpenGitHubClick" />
                                                <TextBlock Grid.Row="4" Text="建议反馈" Classes="fieldLabel" Margin="0,0,20,0" Foreground="{DynamicResource SctTextMutedBrush}" />
                                                <Button Grid.Row="4" Grid.Column="1" Classes="link" Content="提交问题与建议" HorizontalAlignment="Left" Click="OnOpenFeedbackClick" ToolTip.Tip="https://github.com/yusnip/yuSnip/issues" />
                                                <TextBlock Grid.Row="5" Text="第三方致谢" Classes="fieldLabel" Margin="0,0,20,0" Foreground="{DynamicResource SctTextMutedBrush}" />
                                                <Button x:Name="BtnThirdPartyNotices" Grid.Row="5" Grid.Column="1" Classes="link" Content="开源组件与许可" HorizontalAlignment="Left" Click="OnOpenThirdPartyNoticesClick" />
                                            </Grid>
                                            <StackPanel Grid.Row="6" Spacing="12">
                                                <controls:ContinuousBorder Classes="softDivider" />
                                                <TextBlock Text=".NET 10 · C# 14 · Avalonia UI" Classes="fieldHint" Margin="0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </controls:ContinuousBorder>
                                    <controls:ContinuousBorder x:Name="AboutSupportCard" Grid.Column="2" Classes="overviewCard" Padding="20">
                                        <StackPanel Spacing="16" VerticalAlignment="Center">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <TextBlock Text="支持 yuSnip" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                <TextBlock Text="微信扫码赞赏" Classes="fieldHint" Margin="0" HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <controls:ContinuousBorder x:Name="AboutSupportCodeFrame" BorderBrush="{DynamicResource SctSoftBorderBrush}" BorderThickness="1"
                                                                       CornerRadius="{DynamicResource SctRadiusCard}" HorizontalAlignment="Center">
                                                <Image x:Name="ImgSupportCode" Source="/Assets/WeChatAppreciation.jpg" Width="216" Height="216"
                                                       Stretch="Uniform" AutomationProperties.Name="微信赞赏码" />
                                            </controls:ContinuousBorder>
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="如果 yuSnip 对你有所帮助，&#x0a;欢迎扫码，送来一份鼓励。" FontSize="13" LineHeight="21"
                                                           Foreground="{DynamicResource SctTextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock Text="衷心感谢你的慷慨赞赏与支持。" Classes="fieldHint" Margin="0" TextAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                </Grid>

                                <controls:ContinuousBorder Classes="card">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <TextBlock Text="版本与更新" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtAboutVersion" Text="v1.0.0" Classes="fieldHint" Margin="0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button x:Name="BtnAboutToggleChangelog" Content="更新日志" MinWidth="80" Click="OnAboutToggleChangelogClick" />
                                                <Button Content="检查更新" MinWidth="96" Classes="primary" Click="OnCheckUpdateClick" />
                                            </StackPanel>
                                        </Grid>
                                        <controls:ContinuousBorder x:Name="PnlAboutChangelog" IsVisible="False" Background="{DynamicResource SctTitleBarBrush}"
                                                                   CornerRadius="{DynamicResource SctRadiusControl}" Padding="14,12" BorderBrush="{DynamicResource SctSoftBorderBrush}" BorderThickness="1" Margin="0,2,0,2">
                                            <ScrollViewer MaxHeight="260">
                                                <controls:SelectableMarkdownTextBlock x:Name="TxtAboutChangelog" BaseFontSize="13" />
                                            </ScrollViewer>
                                        </controls:ContinuousBorder>
                                        <controls:ContinuousBorder Classes="softDivider" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="启动时自动检查更新" Classes="fieldLabel" VerticalAlignment="Center" />
                                            <controls:ContinuousBorder Grid.Column="1" Classes="segmentedGroup">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadCheckUpdateOff" GroupName="GrpCheckUpdate" Classes="segmented" Content="关闭" />
                                                    <RadioButton x:Name="RadCheckUpdateOn" GroupName="GrpCheckUpdate" Classes="segmented" Content="开启" />
                                                </StackPanel>
                                            </controls:ContinuousBorder>
                                        </Grid>
                                    </StackPanel>
                                </controls:ContinuousBorder>

                                <Grid ColumnDefinitions="*,Auto" Margin="4,4">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
                                            <TextBlock Text="恢复默认设置" Classes="fieldLabel" />
                                            <TextBlock Text="将各项设置恢复为初始状态。" Classes="fieldHint" Margin="0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="恢复默认设置" Classes="secondary" VerticalAlignment="Center" Click="OnRestoreDefaultsClick" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 浮动通知不参与滚动排版；隐藏时关闭命中，避免透明控件拦截表单。 -->
                    <controls:ContinuousBorder Grid.Row="1" x:Name="PnlStatusBar" Classes="statusBar" ZIndex="20"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="28,0,16,16"
                            MinWidth="280" MaxWidth="560" Opacity="0" IsHitTestVisible="False">
                        <controls:ContinuousBorder x:Name="StatusSurface" Classes="statusSurface">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Path x:Name="IconStatusBar" Classes="statusBarIcon" Grid.Column="0"
                                      Data="{x:Static win:OcrIconGeometry.CheckCircle}" />
                                <ScrollViewer Grid.Column="1" MaxHeight="144" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="TxtStatusBar" Classes="statusBarText"
                                               ToolTip.Tip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                                </ScrollViewer>
                                <Button x:Name="BtnStatusClose" Grid.Column="2" Classes="statusClose"
                                        ToolTip.Tip="关闭提示" AutomationProperties.Name="关闭提示" IsVisible="False" Click="OnStatusCloseClick">
                                    <Path Classes="workspaceIcon" Width="10" Height="10" Stroke="{DynamicResource SctTextMutedBrush}" Data="{x:Static win:WorkspaceIconGeometry.Close}" />
                                </Button>
                            </Grid>
                        </controls:ContinuousBorder>
                    </controls:ContinuousBorder>
                </Grid>
            </Grid>


            <!-- 搜索遮罩（scrim）：命令浮层展开时压暗整个主体内容区（左导航+内容），
                 让浮层从背景里"浮"出来——否则浮层底色与内容区底色仅差一档（深色主题下
                 #2B2B2B vs #282828 几乎相同），浅阴影完全分不开；点击遮罩任意处由 Popup
                 light-dismiss 收口关闭浮层，遮罩自身不挂事件 -->
            <controls:ContinuousBorder x:Name="SearchScrim" Grid.Row="1" ZIndex="100"
                    Background="{DynamicResource SctWorkspaceScrimBrush}" IsVisible="False" />

            <!-- 地区选择置于窗口内部：固定尺寸、内容区滚动、底部操作始终可见。 -->
            <Grid x:Name="WeatherPickerOverlay" Grid.RowSpan="2" ZIndex="200" IsVisible="False"
                  Background="{DynamicResource SctWorkspaceScrimBrush}" PointerPressed="OnWeatherBackdropPressed">
                <controls:ContinuousBorder x:Name="WeatherPickerCard" Classes="weatherPickerCard" Width="440" Height="476" Margin="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle">
                    <Grid RowDefinitions="Auto,Auto,*,Auto">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="选择天气地区" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="把当地的天空带进来" Classes="fieldHint" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary" Width="36" MinWidth="36" Height="36" Padding="0" Click="OnWeatherCancelClick" AutomationProperties.Name="关闭地区选择" ToolTip.Tip="关闭">
                                <Path Classes="workspaceIcon" Width="12" Height="12" Data="{x:Static win:WorkspaceIconGeometry.Close}" />
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,16">
                            <TextBlock Text="搜索地区" Classes="fieldHint" />
                            <Grid x:Name="WeatherSearchField" ColumnDefinitions="*,Auto">
                                <TextBox x:Name="TxtWeatherSearch" Watermark="城市、区县或拼音，例如：杭州 西湖" TextChanged="OnWeatherSearchChanged" GotFocus="OnWeatherSearchGotFocus" AutomationProperties.Name="搜索天气地区" />
                                <Button Grid.Column="1" x:Name="BtnWeatherClearSearch" Classes="secondary" Content="清空" Margin="8,0,0,0" IsVisible="False" Click="OnWeatherClearSearchClick" />
                                <Popup x:Name="WeatherSearchPopup" WindowManagerAddShadowHint="False" Placement="BottomEdgeAlignedLeft" VerticalOffset="8"
                                       PlacementTarget="{Binding #WeatherSearchField}" IsLightDismissEnabled="True" OverlayDismissEventPassThrough="True">
                                    <controls:ContinuousBorder x:Name="WeatherSearchSurface" Classes="searchResultPanel" MinWidth="0" Width="{Binding #WeatherSearchField.Bounds.Width}">
                                        <StackPanel>
                                            <controls:ContinuousBorder Classes="searchRHeader">
                                                <TextBlock x:Name="TxtWeatherSearchHeader" Classes="searchRHeaderTitle" />
                                            </controls:ContinuousBorder>
                                            <ListBox x:Name="WeatherSearchResults" Classes="searchResults" IsVisible="False" MaxHeight="154"
                                                     SelectionChanged="OnWeatherSearchSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="匹配的地区" />
                                            <StackPanel x:Name="WeatherSearchEmpty" IsVisible="False" Margin="10,8,10,12">
                                                <TextBlock Text="试试省市名称，或清空搜索后选择。" Classes="searchRDesc" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                </Popup>
                            </Grid>
                        </StackPanel>
                        <Grid Grid.Row="2" Margin="0,0,0,16">
                            <ScrollViewer x:Name="WeatherCascadeScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <Grid x:Name="WeatherCascadeBody" ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Text="省份" Classes="fieldHint" Margin="0,0,0,6" />
                                    <TextBlock Grid.Column="2" Text="城市" Classes="fieldHint" Margin="0,0,0,6" />
                                    <ComboBox Grid.Row="1" x:Name="CmbWeatherProvince" PlaceholderText="选择省份" HorizontalAlignment="Stretch" MaxDropDownHeight="220" SelectionChanged="OnWeatherProvinceChanged" AutomationProperties.Name="省份">
                                        <ComboBox.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Row="1" Grid.Column="2" x:Name="CmbWeatherCity" PlaceholderText="选择城市" HorizontalAlignment="Stretch" MaxDropDownHeight="220" SelectionChanged="OnWeatherCityChanged" AutomationProperties.Name="城市">
                                        <ComboBox.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Text="区／县" Classes="fieldHint" Margin="0,14,0,6" />
                                    <ComboBox Grid.Row="3" Grid.ColumnSpan="3" x:Name="CmbWeatherDistrict" PlaceholderText="选择区县" HorizontalAlignment="Stretch" MaxDropDownHeight="220" SelectionChanged="OnWeatherDistrictChanged" AutomationProperties.Name="区县">
                                        <ComboBox.ItemTemplate><DataTemplate x:DataType="services:WeatherRegion"><TextBlock Text="{Binding District}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FullLabel}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                        <StackPanel Grid.Row="3" Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="TxtWeatherDraft" Text="请选择一个区县" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MinHeight="18" ToolTip.Tip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                                <TextBlock x:Name="TxtWeatherPickerHint" Text="仅查询所选区县的天气，不获取设备定位。" Classes="fieldHint" FontSize="12" TextWrapping="Wrap" MinHeight="18" />
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,*,Auto,8,Auto">
                                <Button x:Name="BtnWeatherDisable" Classes="secondary" Content="关闭天气" Click="OnWeatherDisableClick" />
                                <Button Grid.Column="2" Classes="secondary" Content="取消" MinWidth="64" Click="OnWeatherCancelClick" />
                                <Button Grid.Column="4" x:Name="BtnWeatherApply" Classes="primary" Content="使用这个地区" IsEnabled="False" Click="OnWeatherApplyClick" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </controls:ContinuousBorder>
            </Grid>

            <!-- 危险操作确认浮层：整窗覆盖含标题栏；标题、正文与动作由各入口填写 -->
            <controls:ContinuousBorder x:Name="ConfirmOverlay" Grid.RowSpan="2" Classes="confirmOverlay" ZIndex="300">
                <controls:ContinuousBorder Classes="confirmCard" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="TxtConfirmTitle" Text="恢复默认工具栏布局？" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SctTextPrimaryBrush}" />
                        <TextBlock x:Name="TxtConfirmBody" TextWrapping="Wrap" FontSize="12" MaxWidth="380"
                                   Foreground="{DynamicResource SctTextTertiaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <Button x:Name="BtnConfirmCancel" Content="取消" MinWidth="80" Click="OnConfirmCancelClick" />
                            <Button x:Name="BtnConfirmOk" Content="恢复默认" Classes="primary" MinWidth="96" Click="OnConfirmOkClick" />
                        </StackPanel>
                    </StackPanel>
                </controls:ContinuousBorder>
            </controls:ContinuousBorder>
        </Grid>
    </controls:ContinuousBorder>
</Window>
