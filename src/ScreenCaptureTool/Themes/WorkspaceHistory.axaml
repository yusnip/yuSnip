<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <!-- 仅普通历史查看器消费，不沿用采集工具条的固定暗色控制台。 -->
        <SolidColorBrush x:Key="SctHistoryViewerSurfaceBrush" Color="{DynamicResource SctWorkspaceElevatedColor}" />
        <BoxShadows x:Key="SctHistoryViewerShadow">0 6 20 0 #40000000</BoxShadows>
        <BoxShadows x:Key="SctHistoryMatchShadow">0 4 12 0 #33000000</BoxShadows>
    </Styles.Resources>
</Styles>
