<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ScreenCaptureTool.LongScroll.Controls"
        x:Class="ScreenCaptureTool.LongScroll.Windows.LongScrollBorderWindow"
        Title="LongScrollBorder"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Canvas x:Name="RootCanvas" Background="Transparent" IsHitTestVisible="False">
        <controls:SelectionLayer x:Name="SelectionLayer"
                                 ShowMask="False"
                                 ShowBorderAndHandles="True"
                                 IsHitTestVisible="False" />
        <Border x:Name="ToastBorder"
                IsVisible="False"
                Background="#B2000000"
                CornerRadius="10"
                Padding="14,8"
                IsHitTestVisible="False">
            <TextBlock x:Name="ToastText"
                       Text="已达最大长度，无法继续截图。"
                       Foreground="White"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="13"
                       TextWrapping="Wrap" />
        </Border>
    </Canvas>
</Window>