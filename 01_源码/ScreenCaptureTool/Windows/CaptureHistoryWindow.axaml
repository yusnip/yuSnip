<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:round="using:ScreenCaptureTool.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:ScreenCaptureTool.Windows"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680"
        x:Class="ScreenCaptureTool.Windows.CaptureHistoryWindow"
        x:DataType="local:CaptureHistoryWindow"
        Icon="/Assets/Black.ico"
        Title="截图历史 - yuSnip"
        Width="1000" Height="680"
        MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        Background="{DynamicResource SctTitleBarBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13.5">

    <!-- 本窗不持有任何 ThemeDictionaries：颜色一律引用全局 Sct* Token（设计规范 §2 三层架构、§11）。
         也不写 RequestedThemeVariant——主题变体是作用域继承，窗口写死就脱离 App 作用域（§8.5）。 -->

    <Window.Styles>
        <StyleInclude Source="/Themes/Workspace.axaml" />
        <StyleInclude Source="/Themes/WorkspaceToolTips.axaml" />
        <StyleInclude Source="/Themes/WorkspaceMenus.axaml" />
        <!-- ══════ 缩略图卡片（本窗业务语义样式）══════
             状态一律由 Classes.selected / Classes.hovered 驱动，C# 侧不持有任何画刷（§2 无画刷铁律）。 -->
        <Style Selector="Border.historyCard">
            <Setter Property="Background" Value="{DynamicResource SctCardFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
            <Setter Property="Width" Value="180" />
            <Setter Property="Height" Value="150" />
            <Setter Property="Margin" Value="6,6,6,6" /><!-- 四边对称：行距 6+6=12 不变，上下边缘留白相等（2026-09-10 垂直对称） -->
            <Setter Property="Cursor" Value="Hand" />
            <!-- 只过渡描边：底色（不透明卡片底 → 半透明品牌紫）走 BrushTransition 会在
                 ARGB 插值中段滑出脏紫（§9.9，OcrWindow 已有一次踩坑记录） -->
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.historyCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SctBorderBrush}" />
        </Style>
        <!-- 选中态必须声明在 :pointerover 之后：同优先级下后声明者胜出（§9.2） -->
        <Style Selector="Border.historyCard.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SctAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- 缩略图承载区：棋盘感的弱底，透明图与浅色图都能看清边界。
             刻意不写 Height：卡片总高钉死 150，缩略图吃 Grid 的 * 行剩余空间 ⇒ 带文字摘要的
             卡片自动让出第三行的位置（设计稿 §02 .hcard / .hcard.t3 的 92 → 73）。 -->
        <Style Selector="Border.historyThumbHost">
            <Setter Property="Background" Value="{DynamicResource SctInputBgBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource SctRadiusControl}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!-- 卡片内文字两档 -->
        <Style Selector="TextBlock.historyCardTime">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.historyCardMeta">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextTertiaryBrush}" />
        </Style>
        <!-- 卡片第三行：可搜文本摘要（一行、末尾省略号；没有文字时写「尚未识别」占住这一行，
             免得同屏卡片高低不齐）。命中处的底色由代码换 Inlines，见 ApplyHighlight。 -->
        <Style Selector="TextBlock.historyCardSummary">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextTertiaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- 详情栏栏头（与 OCR 窗口栏头同款 36px 发丝线通栏） -->
        <Style Selector="Border.historyPaneHead">
            <Setter Property="Background" Value="{DynamicResource SctTitleBarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SctSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="36" />
        </Style>

        <!-- 详情栏元信息行：左标签右值 -->
        <Style Selector="TextBlock.historyMetaLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextTertiaryBrush}" />
        </Style>
        <Style Selector="TextBlock.historyMetaValue">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextSecondaryBrush}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- 详情栏识别文字正文（最多 3 行由实例上的 MaxLines 决定，超出截断不滚动） -->
        <Style Selector="TextBlock.historyDetailText">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource SctTextSecondaryBrush}" />
        </Style>

        <!-- 搜索框：尺寸/圆角/底色全部沿用全局 TextBox 基准（32 高），这里只加左右内衬 ——
             左侧留给框内放大镜，右侧留给清空按钮（A 案：放大镜在框内左侧）。 -->
        <Style Selector="TextBox.historySearch">
            <Setter Property="Width" Value="240" />
            <Setter Property="Padding" Value="30,6,28,6" />
        </Style>

        <!-- 关闭按钮与 OCR 窗口同款（44×36 贴边直角） -->
        <Style Selector="Button.titleCloseBtn">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.titleCloseBtn /template/ ContentPresenter#PART_ContinuousPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.titleCloseBtn:pointerover /template/ ContentPresenter#PART_ContinuousPresenter">
            <Setter Property="Background" Value="{DynamicResource SctTitleBarCloseBrush}" />
        </Style>
        <Style Selector="Button.titleCloseBtn:pointerover Path">
            <Setter Property="Fill" Value="{DynamicResource SctTitleBarCloseTextBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="36,46,*,30">

        <!-- ══════ 1. 顶栏 Header (36px) ══════ -->
        <Border Grid.Row="0" Height="36" Background="{DynamicResource SctTitleBarBrush}"
                BorderBrush="{DynamicResource SctSoftBorderBrush}" BorderThickness="0,0,0,1"
                Padding="14,0,0,0" PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Image x:Name="ImgAppLogo" Grid.Column="0" Width="18" Height="18"
                       Source="/Assets/Black.ico" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="截图历史" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource SctTextPrimaryBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch" Margin="0" Spacing="0">
                    <Button Classes="titleIcon titleBarBtn" Content="—" ToolTip.Tip="最小化" Click="OnMinimizeClick" />
                    <Button Classes="titleIcon titleBarBtn closeBtn" Content="✕" ToolTip.Tip="关闭 (Esc)" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════ 2. 工具栏 (46px，设计规范 §7.2) ══════ -->
        <Border Grid.Row="1" Height="46" Background="{DynamicResource SctBackgroundBrush}"
                BorderBrush="{DynamicResource SctSoftBorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- 左：来源筛选 -->
                <round:ContinuousBorder Grid.Column="0" Classes="segmentedGroup" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RadFilterAll" GroupName="GrpHistoryFilter" Classes="segmented" Content="全部" IsChecked="True" />
                        <Rectangle Classes="segmentedDivider" />
                        <RadioButton x:Name="RadFilterCapture" GroupName="GrpHistoryFilter" Classes="segmented" Content="截图" />
                        <Rectangle Classes="segmentedDivider" />
                        <RadioButton x:Name="RadFilterSticker" GroupName="GrpHistoryFilter" Classes="segmented" Content="贴图" />
                        <Rectangle Classes="segmentedDivider" />
                        <RadioButton x:Name="RadFilterLong" GroupName="GrpHistoryFilter" Classes="segmented" Content="长截图" />
                    </StackPanel>
                </round:ContinuousBorder>

                <!-- 右：搜索框（常驻）＋ 清空历史。一个框吃两种查询：先按日期形态分流，
                     走不了才当关键词，不拆框、不加模式开关（设计稿 §03）。 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Panel>
                        <TextBox x:Name="TxtSearch" Classes="historySearch"
                                 Watermark="搜索时间 / 文字"
                                 TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" />
                        <!-- 放大镜与清空叉都只是覆盖在框上的装饰，命中测试交回输入框本体 -->
                        <Path Classes="sctIcon" Data="{x:Static local:OcrIconGeometry.Search}"
                              IsHitTestVisible="False" HorizontalAlignment="Left" Margin="9,0,0,0" />
                        <Button x:Name="BtnSearchClear" Classes="sctIconBtn" IsVisible="False"
                                HorizontalAlignment="Right" Margin="0,0,3,0"
                                Click="OnSearchClearClick" ToolTip.Tip="清空搜索 (Esc)">
                            <Path Classes="sctIcon" Data="{x:Static local:OcrIconGeometry.Close}" Width="11" Height="11" />
                        </Button>
                    </Panel>
                    <Button x:Name="BtnClearAll" Classes="secondary" Content="清空历史"
                            VerticalAlignment="Center" Click="OnClearAllClick" ToolTip.Tip="删除全部历史图片，不可恢复" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════ 3. 主体：网格 ‖ 发丝线 ‖ 详情栏 ══════
             默认收起详情栏（列 *,0,0 + 隐藏），点选卡片后由 UpdateDetailPane 展开为 *,1,300 -->
        <Grid Grid.Row="2" x:Name="GridMain" ColumnDefinitions="*,0,0">

            <!-- 左：缩略图网格 -->
            <ScrollViewer Grid.Column="0" x:Name="ScrollCards"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource SctPanelBrush}">
                <!-- 网格自适应对齐（2026-09-10，同日迭代 5）：垂直一律顶对齐（垂直居中会让单张结果悬在
                     窗口正中，反直觉）；水平由 UpdateGridHorizontalAlignment 动态决定——内容距铺满
                     不到一列宽时居中（零头对称分摊、左右留白相等），差得多（如搜索只剩一两张）时贴左 -->
                <ItemsControl x:Name="ItemsHistory" Margin="16,16,16,16"
                              HorizontalAlignment="Left" VerticalAlignment="Top">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:HistoryCardItem">
                            <round:ContinuousBorder Classes="historyCard"
                                    Classes.selected="{Binding IsSelected}"
                                    PointerPressed="OnCardPointerPressed"
                                    Tag="{Binding Id}">
                                <round:ContinuousBorder.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="复制到剪贴板" Click="OnCtxCopyClick">
                                            <MenuItem.Icon><Path Classes="menuIcon" Data="{x:Static local:OcrIconGeometry.Copy}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="贴到屏幕" Click="OnCtxStickerClick">
                                            <MenuItem.Icon><Path Classes="menuIcon" Data="{x:Static local:OcrIconGeometry.CropFree}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="另存为..." Click="OnCtxSaveAsClick">
                                            <MenuItem.Icon><Path Classes="menuIcon" Data="{x:Static local:OcrIconGeometry.Save}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="打开文件位置" Click="OnCtxOpenLocationClick">
                                            <MenuItem.Icon><Path Classes="menuIcon" Data="{x:Static local:OcrIconGeometry.TraySaveDir}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <!-- InputGesture 键名必须是合法 Key 枚举：Delete 而非 Del（§9.5） -->
                                        <MenuItem Header="删除" InputGesture="Delete" Click="OnCtxDeleteClick">
                                            <MenuItem.Icon><Path Classes="menuIcon" Data="{x:Static local:OcrIconGeometry.Delete}" /></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </round:ContinuousBorder.ContextMenu>

                                <Grid RowDefinitions="*,Auto" Margin="8">
                                    <round:ContinuousBorder Grid.Row="0" Classes="historyThumbHost">
                                        <Grid>
                                            <!-- 缩略图缺失时退化为占位图标 -->
                                            <Path Classes="sctIcon" Width="28" Height="28"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="{x:Static local:OcrIconGeometry.Image}"
                                                  IsVisible="{Binding !HasThumbnail}" />
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2"
                                                   IsVisible="{Binding HasThumbnail}" />
                                        </Grid>
                                    </round:ContinuousBorder>
                                    <StackPanel Grid.Row="1" Spacing="2" Margin="2,6,2,0">
                                        <TextBlock Classes="historyCardTime" Text="{Binding TimeText}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="historyCardMeta" Text="{Binding SizeText}" />
                                            <round:ContinuousBorder Grid.Column="1" Classes="badge" CornerRadius="{DynamicResource SctRadiusSmall}">
                                                <TextBlock Text="{Binding SourceText}" FontSize="11" FontWeight="Medium"
                                                           Foreground="{DynamicResource SctBadgeTextBrush}" />
                                            </round:ContinuousBorder>
                                        </Grid>
                                        <!-- 第三行：可搜文本摘要。命中高亮要往 Inlines 里塞 Run，
                                             绑定做不到，故在容器实现后由代码重建（设计稿 §06 三处高亮之一） -->
                                        <TextBlock Classes="historyCardSummary" Text="{Binding SummaryText}"
                                                   Loaded="OnCardSummaryLoaded" />
                                    </StackPanel>
                                </Grid>
                            </round:ContinuousBorder>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空态：与列表同层叠放，靠 IsVisible 互斥 -->
            <StackPanel Grid.Column="0" x:Name="PnlEmptyState" Spacing="10"
                        HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False">
                <Path x:Name="IconEmpty" Classes="sctIcon" Width="40" Height="40" HorizontalAlignment="Center"
                      Data="{x:Static local:OcrIconGeometry.TrayHistory}" />
                <TextBlock x:Name="TxtEmptyTitle" Text="暂无截图历史" FontSize="13.5"
                           HorizontalAlignment="Center" Foreground="{DynamicResource SctTextSecondaryBrush}" />
                <TextBlock x:Name="TxtEmptyHint" Text="截图历史当前已关闭，可在设置中开启。"
                           FontSize="12" MaxWidth="360" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Foreground="{DynamicResource SctTextTertiaryBrush}" />
                <Button x:Name="BtnEmptyOpenSettings" Classes="link" Content="打开设置"
                        HorizontalAlignment="Center" Click="OnOpenSettingsClick" />
                <Button x:Name="BtnEmptyClearSearch" Classes="link" Content="清空搜索条件"
                        HorizontalAlignment="Center" IsVisible="False" Click="OnSearchClearClick" />
            </StackPanel>

            <Rectangle Grid.Column="1" x:Name="SepDetail" Fill="{DynamicResource SctSoftBorderBrush}" IsVisible="False" />

            <!-- 右：详情栏 -->
            <Grid Grid.Column="2" x:Name="PnlDetail" RowDefinitions="36,*" IsVisible="False">
                <Border Grid.Row="0" Classes="historyPaneHead">
                    <TextBlock Text="详情" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource SctSubTitleBrush}" VerticalAlignment="Center" />
                </Border>

                <!-- 未选中时的占位 -->
                <TextBlock Grid.Row="1" x:Name="TxtDetailPlaceholder" Text="选择左侧任一记录查看详情"
                           FontSize="12" Foreground="{DynamicResource SctTextTertiaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           Margin="24,0" TextAlignment="Center" />

                <!-- 搜索中且未选中：三个计数常驻详情栏（与上面占位文案互斥） -->
                <StackPanel Grid.Row="1" x:Name="PnlDetailCounts" IsVisible="False"
                            Margin="16,16,16,20" Spacing="8">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Classes="historyMetaLabel" Text="命中" />
                        <TextBlock Grid.Column="1" x:Name="TxtCountHit" Classes="historyMetaValue" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Classes="historyMetaLabel" Text="已识别" />
                        <TextBlock Grid.Column="1" x:Name="TxtCountDone" Classes="historyMetaValue" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Classes="historyMetaLabel" Text="未识别" />
                        <TextBlock Grid.Column="1" x:Name="TxtCountPending" Classes="historyMetaValue" />
                    </Grid>
                </StackPanel>

                <ScrollViewer Grid.Row="1" x:Name="ScrollDetail" IsVisible="False"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,16,16,20" Spacing="14">
                        <!-- 大图预览 -->
                        <round:ContinuousBorder Classes="historyThumbHost" Height="180">
                            <Image x:Name="ImgPreview" Stretch="Uniform" Margin="4" />
                        </round:ContinuousBorder>

                        <!-- 元信息 -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Classes="historyMetaLabel" Text="时间" />
                                <TextBlock Grid.Column="1" x:Name="TxtDetailTime" Classes="historyMetaValue" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Classes="historyMetaLabel" Text="尺寸" />
                                <TextBlock Grid.Column="1" x:Name="TxtDetailSize" Classes="historyMetaValue" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Classes="historyMetaLabel" Text="来源" />
                                <TextBlock Grid.Column="1" x:Name="TxtDetailSource" Classes="historyMetaValue" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Classes="historyMetaLabel" Text="占用" />
                                <TextBlock Grid.Column="1" x:Name="TxtDetailBytes" Classes="historyMetaValue" />
                            </Grid>
                            <Grid x:Name="RowDetailPath" ColumnDefinitions="Auto,*" IsVisible="False">
                                <TextBlock Grid.Column="0" Classes="historyMetaLabel" Text="原文件" />
                                <TextBlock Grid.Column="1" x:Name="TxtDetailPath" Classes="historyMetaValue"
                                           ToolTip.Tip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                            </Grid>
                        </StackPanel>

                        <Border Background="{DynamicResource SctSoftBorderBrush}" Height="1" />

                        <!-- 识别文字（设计稿 §04 甲案）：正文最多 3 行，超出截断不滚动 ——
                             详情栏可用高 496，再给多了就得整栏滚，反而看不见按钮 -->
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Classes="historyMetaLabel" Text="识别文字" />
                                <TextBlock Grid.Column="1" x:Name="TxtDetailTextMeta" Classes="historyMetaValue" />
                            </Grid>
                            <TextBlock x:Name="TxtDetailText" Classes="historyDetailText"
                                       TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- 操作组：两行四枚（第三轮拍板项 3）。「打开文件位置」退回卡片右键菜单 -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,8,*">
                                <Button Grid.Column="0" x:Name="BtnCopy" Classes="primary" Content="复制到剪贴板"
                                        HorizontalAlignment="Stretch" Click="OnCopyClick" />
                                <Button Grid.Column="2" x:Name="BtnSticker" Classes="secondary" Content="贴到屏幕"
                                        HorizontalAlignment="Stretch" Click="OnStickerClick"
                                        ToolTip.Tip="双击卡片也可直接贴图" />
                            </Grid>
                            <Grid ColumnDefinitions="*,8,*">
                                <Button Grid.Column="0" x:Name="BtnSaveAs" Classes="secondary" Content="另存为..."
                                        HorizontalAlignment="Stretch" Click="OnSaveAsClick" />
                                <Button Grid.Column="2" x:Name="BtnDelete" Classes="secondary" Content="删除这条记录"
                                        HorizontalAlignment="Stretch" Click="OnDeleteClick" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ══════ 4. 底部状态栏 (30px) ══════ -->
        <Border Grid.Row="3" Height="30" Background="{DynamicResource SctTitleBarBrush}"
                BorderBrush="{DynamicResource SctSoftBorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="共" FontSize="12" Foreground="{DynamicResource SctTextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtStatusCount" Text="0" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource SctTextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="张" FontSize="12" Foreground="{DynamicResource SctTextMutedBrush}" VerticalAlignment="Center" />
                    <!-- 命中计数常驻状态栏，不弹窗（弹窗只在输入被判成时间表达式时用一次） -->
                    <StackPanel x:Name="PnlStatusHit" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" IsVisible="False">
                        <TextBlock Text="· 命中" FontSize="12" Foreground="{DynamicResource SctTextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtStatusHit" Text="0" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SctTextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="条" FontSize="12" Foreground="{DynamicResource SctTextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TxtStatusUsage" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource SctTextMutedBrush}" />
                <TextBlock Grid.Column="3" x:Name="TxtStatusHint" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource SctTextTertiaryBrush}" />
            </Grid>
        </Border>

        <!-- ══════ 5. 悬浮 Toast（与 OCR 窗口同款）══════ -->
        <round:ContinuousBorder x:Name="ToastPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,30" Background="{DynamicResource SctMenuBackgroundBrush}"
                BorderBrush="{DynamicResource SctBorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource SctRadiusControl}" Padding="16,8"
                IsHitTestVisible="False" Opacity="0" IsVisible="False">
            <round:ContinuousBorder.BoxShadow>
                <BoxShadows>0 4 16 0 #26000000</BoxShadows>
            </round:ContinuousBorder.BoxShadow>
            <TextBlock x:Name="TxtToast" Text="" FontSize="13"
                       Foreground="{DynamicResource SctTextPrimaryBrush}" VerticalAlignment="Center" />
        </round:ContinuousBorder>
    </Grid>
</Window>
