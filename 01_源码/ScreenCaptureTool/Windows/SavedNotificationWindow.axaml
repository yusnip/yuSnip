<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:round="using:ScreenCaptureTool.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="110"
        x:Class="ScreenCaptureTool.Windows.SavedNotificationWindow"
        Title="截图已保存"
        Width="620"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        FontFamily="Microsoft YaHei UI"
        PointerPressed="OnRootPointerPressed"
        PointerEntered="OnRootPointerEntered"
        PointerExited="OnRootPointerExited"
        KeyDown="OnWindowKeyDown">
    <Window.Styles>
        <StyleInclude Source="/Themes/Workspace.axaml" />
    </Window.Styles>
    <!-- 根卡片：Margin 26 ＝ 全局浮层档投影（0 6 20）所需的「偏移 6 ＋ 模糊 20」透明缓冲包络（下沿最大），
         窗口因此比可见卡片四周各宽 26。投影值走 Token，与其余独立浮窗同一份（§3.6 第五铁律）。 -->
    <round:ContinuousBorder Margin="26"
            Padding="18,14"
            Background="{DynamicResource SctCardFillBrush}"
            BorderBrush="{DynamicResource SctSoftBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource SctRadiusCard}"
            BoxShadow="{DynamicResource SctShadowOverlay}">
        <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0"
                    Width="10"
                    Height="10"
                    CornerRadius="5"
                    Background="{DynamicResource SctAccentBrush}"
                    VerticalAlignment="Top"
                    Margin="0,5,12,0" />

            <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock x:Name="TxtTitle" Text="截图已保存"
                           Foreground="{DynamicResource SctTextPrimaryBrush}"
                           FontSize="17"
                           FontWeight="SemiBold" />

                <TextBlock x:Name="TxtSavedPath"
                           Foreground="{DynamicResource SctTextSecondaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           MaxHeight="38" />

                <TextBlock Text="点击打开所在位置 · 悬停暂停关闭"
                           Foreground="{DynamicResource SctAccentBrush}"
                           FontSize="11" />
            </StackPanel>
        </Grid>
    </round:ContinuousBorder>
</Window>
